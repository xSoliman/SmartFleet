@model IEnumerable<SmartFleet.Models.Geofence>
@using SmartFleet.Models;
@{
    ViewData["Title"] = "Geofences";
}
<h1>Geofences</h1>
<a asp-action="Create" class="btn btn-primary">Create New Geofence</a>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Shape</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Type</td>
            <td>
                @if (item.Type == GeofenceType.Circle)
                {
                    <span>Center: @item.CenterLat, @item.CenterLng<br />Radius: @item.RadiusMeters m</span>
                }
                else if (item.Type == GeofenceType.Polygon && !string.IsNullOrEmpty(item.PolygonJson))
                {
                    var points = Newtonsoft.Json.JsonConvert.DeserializeObject<List<List<double>>>(item.PolygonJson);
                    <span>Polygon with @points.Count points</span>
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                <a asp-action="Assign" asp-route-id="@item.Id" class="btn btn-sm btn-info">Assign Vehicles</a>
            </td>
        </tr>
    }
    </tbody>
</table> 