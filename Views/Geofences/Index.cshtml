@model IEnumerable<SmartFleet.Models.Geofence>
@{
    ViewData["Title"] = "Geofences";
}
<h1>Geofences</h1>
<a asp-action="Create" class="btn btn-primary">Create New Geofence</a>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Center (Lat, Lng)</th>
            <th>Radius (meters)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.CenterLat, @item.CenterLng</td>
            <td>@item.RadiusMeters</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                <a asp-action="Assign" asp-route-id="@item.Id" class="btn btn-sm btn-info">Assign Vehicles</a>
            </td>
        </tr>
    }
    </tbody>
</table> 