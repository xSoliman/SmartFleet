@model SmartFleet.Models.Geofence
@using SmartFleet.Models;
@{
    ViewData["Title"] = "Edit Geofence";
}
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet-draw/dist/leaflet.draw.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-draw/dist/leaflet.draw.js"></script>
<h1>Edit Geofence</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Type">Geofence Type</label>
        <select asp-for="Type" class="form-control" id="GeofenceType">
            <option value="0">Circle</option>
            <option value="1">Polygon</option>
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Draw Geofence on Map</label>
        <div id="map" style="height: 500px;"></div>
    </div>
    <div id="circleFields">
        <div class="form-group">
            <label asp-for="CenterLat"></label>
            <input asp-for="CenterLat" class="form-control" id="CenterLat" readonly />
            <span asp-validation-for="CenterLat" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="CenterLng"></label>
            <input asp-for="CenterLng" class="form-control" id="CenterLng" readonly />
            <span asp-validation-for="CenterLng" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="RadiusMeters"></label>
            <input asp-for="RadiusMeters" class="form-control" id="RadiusMeters" type="number" min="10" max="100000" step="10" />
            <span asp-validation-for="RadiusMeters" class="text-danger"></span>
        </div>
    </div>
    <div id="polygonFields" style="display:none;">
        <div class="alert alert-info">Draw a polygon on the map using the polygon tool.</div>
    </div>
    <input type="hidden" asp-for="PolygonJson" id="PolygonJson" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
<script>
    var type = @((int)Model.Type);
    var currentLat = @Model.CenterLat;
    var currentLng = @Model.CenterLng;
    var currentRadius = @Model.RadiusMeters;
    var polygonJson = @Html.Raw(Model.PolygonJson == null ? "null" : $"'{Model.PolygonJson}'");
    var map = L.map('map').setView([currentLat || 27.18096, currentLng || 31.18368], 14);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
    }).addTo(map);

    // Circle controls
    var marker = L.marker([currentLat, currentLng], { draggable: true });
    var circle = L.circle([currentLat, currentLng], { radius: currentRadius });

    // Polygon controls
    var drawnItems = new L.FeatureGroup();
    map.addLayer(drawnItems);
    var drawControl = new L.Control.Draw({
        draw: {
            polygon: true, // always enabled
            polyline: false,
            rectangle: false,
            circle: false,
            marker: false,
            circlemarker: false
        },
        edit: {
            featureGroup: drawnItems
        }
    });
    map.addControl(drawControl);

    function showCircleFields(show) {
        document.getElementById('circleFields').style.display = show ? '' : 'none';
        if (show) {
            marker.addTo(map);
            circle.addTo(map);
        } else {
            map.removeLayer(marker);
            map.removeLayer(circle);
        }
    }
    function showPolygonFields(show) {
        document.getElementById('polygonFields').style.display = show ? '' : 'none';
    }
    function showDrawToolbar(show) {
        var drawToolbar = document.querySelector('.leaflet-draw-toolbar-top');
        if (drawToolbar) drawToolbar.style.display = show ? '' : 'none';
    }

    // Pre-fill polygon if exists
    if (type === 1 && polygonJson && polygonJson !== 'null') {
        var coords = JSON.parse(polygonJson);
        var polygon = L.polygon(coords);
        drawnItems.addLayer(polygon);
        document.getElementById('PolygonJson').value = JSON.stringify(coords);
        map.fitBounds(polygon.getBounds());
    }

    // Handle geofence type change
    document.getElementById('GeofenceType').addEventListener('change', function () {
        var type = this.value;
        if (type == '0') {
            showCircleFields(true);
            showPolygonFields(false);
            showDrawToolbar(false);
            drawnItems.clearLayers();
            document.getElementById('PolygonJson').value = '';
        } else {
            showCircleFields(false);
            showPolygonFields(true);
            showDrawToolbar(true);
            map.removeLayer(marker);
            map.removeLayer(circle);
        }
    });

    // Circle logic
    marker.on('drag', function (e) {
        var latlng = marker.getLatLng();
        document.getElementById('CenterLat').value = latlng.lat.toFixed(6);
        document.getElementById('CenterLng').value = latlng.lng.toFixed(6);
        circle.setLatLng(latlng);
    });
    document.getElementById('RadiusMeters').addEventListener('input', function () {
        var r = parseFloat(this.value);
        if (!isNaN(r)) circle.setRadius(r);
    });
    map.on('click', function (e) {
        if (document.getElementById('GeofenceType').value == '0') {
            marker.setLatLng(e.latlng);
            document.getElementById('CenterLat').value = e.latlng.lat.toFixed(6);
            document.getElementById('CenterLng').value = e.latlng.lng.toFixed(6);
            circle.setLatLng(e.latlng);
        }
    });

    // Polygon logic
    map.on(L.Draw.Event.CREATED, function (e) {
        if (document.getElementById('GeofenceType').value == '1') {
            drawnItems.clearLayers();
            drawnItems.addLayer(e.layer);
            var latlngs = e.layer.getLatLngs()[0].map(function (latlng) {
                return [latlng.lat, latlng.lng];
            });
            document.getElementById('PolygonJson').value = JSON.stringify(latlngs);
        }
    });
    map.on(L.Draw.Event.EDITED, function (e) {
        if (document.getElementById('GeofenceType').value == '1') {
            var layers = e.layers;
            layers.eachLayer(function (layer) {
                var latlngs = layer.getLatLngs()[0].map(function (latlng) {
                    return [latlng.lat, latlng.lng];
                });
                document.getElementById('PolygonJson').value = JSON.stringify(latlngs);
            });
        }
    });
    map.on(L.Draw.Event.DELETED, function (e) {
        if (document.getElementById('GeofenceType').value == '1') {
            document.getElementById('PolygonJson').value = '';
        }
    });
    // On submit, validate polygon if type is polygon
    document.querySelector('form').addEventListener('submit', function (e) {
        if (document.getElementById('GeofenceType').value == '1' && !document.getElementById('PolygonJson').value) {
            alert('Please draw a polygon on the map.');
            e.preventDefault();
        }
    });

    // On page load, set correct UI
    if (type === 0) {
        showCircleFields(true);
        showPolygonFields(false);
        showDrawToolbar(false);
        marker.addTo(map);
        circle.addTo(map);
    } else {
        showCircleFields(false);
        showPolygonFields(true);
        showDrawToolbar(true);
        map.removeLayer(marker);
        map.removeLayer(circle);
    }

    // Block polygon drawing if not in polygon mode
    map.on(L.Draw.Event.DRAWSTART, function (e) {
        if (document.getElementById('GeofenceType').value != '1') {
            map.fire('draw:drawstop');
        }
    });
</script> 