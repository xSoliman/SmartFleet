@model SmartFleet.Models.Geofence
@{
    ViewData["Title"] = "Delete Geofence";
}
<h1>Delete Geofence</h1>
<h3>Are you sure you want to delete this geofence?</h3>
<div>
    <h4>@Model.Name</h4>
    <p>Center: @Model.CenterLat, @Model.CenterLng</p>
    <p>Radius: @Model.RadiusMeters meters</p>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form> 