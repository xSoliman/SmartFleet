@model SmartFleet.ViewModel.ReportsViewModel
@{
    ViewData["Title"] = "Reports & Statistics";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/pages/reports/reports.css" />

<div class="reports-page">
    <div class="container-fluid">
        <!-- Enhanced Responsive Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <div class="header-content mb-3 mb-md-0">
                        <h2 class="mb-1 text-dark">
                            <i class="fas fa-chart-line me-2 text-primary"></i>
                            Reports & Statistics
                        </h2>
                        <p class="text-muted mb-0">Comprehensive analytics and insights for your fleet</p>
                    </div>
                    <div class="action-buttons d-flex flex-column flex-sm-row gap-2">
                        <button class="btn btn-info btn-enhanced" data-bs-toggle="modal" data-bs-target="#reportGeneratorModal">
                            <i class="fas fa-file-export me-2"></i>
                            <span class="d-none d-sm-inline">Generate Report</span>
                            <span class="d-sm-none">Generate</span>
                        </button>
                        <button class="btn btn-success btn-enhanced" onclick="exportToPDF()">
                            <i class="fas fa-file-pdf me-2"></i>
                            <span class="d-none d-sm-inline">Export PDF</span>
                            <span class="d-sm-none">PDF</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Key Performance Indicators - Responsive Grid -->
        <div class="row mb-5">
            <div class="col-12">
                <h4 class="mb-3">
                    <i class="fas fa-tachometer-alt me-2 text-info"></i>
                    Key Performance Indicators
                </h4>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card kpi-card fleet-utilization h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                        <div class="number">@Model.FleetUtilizationPercentage%</div>
                        <p class="label">Fleet Utilization</p>
                        <div class="stats-subtitle">@Model.VehiclesOnTrip of @Model.TotalVehicles vehicles active</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card kpi-card driver-efficiency h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-users-cog"></i>
                        </div>
                        <div class="number">@Model.DriverEfficiencyPercentage%</div>
                        <p class="label">Driver Efficiency</p>
                        <div class="stats-subtitle">@(Model.DriversOnTrip + Model.BusyDrivers) of @Model.TotalDrivers drivers busy</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card kpi-card total-distance h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-route"></i>
                        </div>
                        <div class="number">@Model.TotalDistanceTraveled.ToString("N0")</div>
                        <p class="label">Total Distance (KM)</p>
                        <div class="stats-subtitle">Across all vehicles</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card kpi-card completion-rate h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="number">@(Model.TotalTrips > 0 ? Math.Round((double)Model.CompletedTrips / Model.TotalTrips * 100, 1) : 0)%</div>
                        <p class="label">Trip Completion Rate</p>
                        <div class="stats-subtitle">@Model.CompletedTrips of @Model.TotalTrips trips</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fleet Statistics - Responsive Grid -->
        <div class="row mb-5">
            <div class="col-12">
                <h4 class="mb-3">
                    <i class="fas fa-car me-2 text-primary"></i>
                    Fleet Overview
                </h4>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card stats-card total-vehicles h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-car"></i>
                        </div>
                        <div class="number">@Model.TotalVehicles</div>
                        <p class="label">Total Vehicles</p>
                        <div class="stats-subtitle">Fleet size</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card stats-card active-vehicles h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-car-side"></i>
                        </div>
                        <div class="number">@Model.ActiveVehicles</div>
                        <p class="label">Available Vehicles</p>
                        <div class="stats-subtitle">Ready for dispatch</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card stats-card vehicles-on-trip h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-location-arrow"></i>
                        </div>
                        <div class="number">@Model.VehiclesOnTrip</div>
                        <p class="label">On Trip</p>
                        <div class="stats-subtitle">Currently traveling</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card stats-card vehicles-maintenance h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-tools"></i>
                        </div>
                        <div class="number">@Model.VehiclesNeedMaintenance</div>
                        <p class="label">Need Maintenance</p>
                        <div class="stats-subtitle">Require attention</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Operations Statistics - Responsive Grid -->
        <div class="row mb-5">
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card stats-card total-drivers h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="number">@Model.TotalDrivers</div>
                        <p class="label">Total Drivers</p>
                        <div class="stats-subtitle">@Model.AvailableDrivers available</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card stats-card total-trips h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-route"></i>
                        </div>
                        <div class="number">@Model.TotalTrips</div>
                        <p class="label">Total Trips</p>
                        <div class="stats-subtitle">@Model.ActiveTrips active</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card stats-card total-orders h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-clipboard-list"></i>
                        </div>
                        <div class="number">@Model.TotalOrders</div>
                        <p class="label">Total Orders</p>
                        <div class="stats-subtitle">@Model.PendingOrders pending</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                <div class="card stats-card total-maintenance h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-wrench"></i>
                        </div>
                        <div class="number">@Model.TotalMaintenances</div>
                        <p class="label">Maintenance Records</p>
                        <div class="stats-subtitle">@Model.PendingMaintenances pending</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row - Responsive Layout -->
        <div class="row mb-5">
            <div class="col-xl-6 col-lg-12 mb-4">
                <div class="card chart-card h-100">
                    <div class="card-header">
                        <h5><i class="fas fa-chart-line me-2"></i>Trips Trend (Last 6 Months)</h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas id="tripsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-12 mb-4">
                <div class="card chart-card h-100">
                    <div class="card-header">
                        <h5><i class="fas fa-chart-bar me-2"></i>Orders Trend (Last 6 Months)</h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas id="ordersChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-xl-6 col-lg-12 mb-4">
                <div class="card chart-card h-100">
                    <div class="card-header">
                        <h5><i class="fas fa-chart-pie me-2"></i>Vehicle Status Distribution</h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas id="vehicleStatusChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-12 mb-4">
                <div class="card chart-card h-100">
                    <div class="card-header">
                        <h5><i class="fas fa-chart-doughnut me-2"></i>Driver Status Distribution</h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas id="driverStatusChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activities - Responsive Layout -->
        <div class="row mb-5">
            <div class="col-xl-4 col-lg-6 col-md-12 mb-4">
                <div class="card activity-card h-100">
                    <div class="card-header">
                        <h5><i class="fas fa-route me-2"></i>Recent Trips</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="activity-list">
                            @if (Model.RecentTrips.Any())
                            {
                                @foreach (var trip in Model.RecentTrips)
                                {
                                    <div class="activity-item">
                                        <div class="activity-icon trips">
                                            <i class="fas fa-car"></i>
                                        </div>
                                        <div class="activity-content">
                                            <div class="activity-title">@trip.VehicleLicensePlate - @trip.DriverName</div>
                                            <div class="activity-description">@trip.StartLocation → @trip.Destination</div>
                                            <div class="activity-meta">
                                                <span class="status-badge @trip.Status.ToLower()">@trip.Status</span>
                                                <span class="activity-time">@trip.CreatedAt.ToString("MMM dd, HH:mm")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="no-data">No recent trips</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-lg-6 col-md-12 mb-4">
                <div class="card activity-card h-100">
                    <div class="card-header">
                        <h5><i class="fas fa-clipboard-list me-2"></i>Recent Orders</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="activity-list">
                            @if (Model.RecentOrders.Any())
                            {
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <div class="activity-item">
                                        <div class="activity-icon orders">
                                            <i class="fas fa-clipboard"></i>
                                        </div>
                                        <div class="activity-content">
                                            <div class="activity-title">@order.UserName</div>
                                            <div class="activity-description">@order.StartLocation → @order.Destination</div>
                                            <div class="activity-meta">
                                                <span class="status-badge @order.Status.ToLower()">@order.Status</span>
                                                <span class="activity-time">@order.CreatedAt.ToString("MMM dd, HH:mm")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="no-data">No recent orders</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-lg-6 col-md-12 mb-4">
                <div class="card activity-card h-100">
                    <div class="card-header">
                        <h5><i class="fas fa-tools me-2"></i>Recent Maintenance</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="activity-list">
                            @if (Model.RecentMaintenances.Any())
                            {
                                @foreach (var maintenance in Model.RecentMaintenances)
                                {
                                    <div class="activity-item">
                                        <div class="activity-icon maintenance">
                                            <i class="fas fa-wrench"></i>
                                        </div>
                                        <div class="activity-content">
                                            <div class="activity-title">@maintenance.VehicleLicensePlate</div>
                                            <div class="activity-description">@maintenance.IssueDescription</div>
                                            <div class="activity-meta">
                                                <span class="status-badge @maintenance.Status.ToLower()">@maintenance.Status</span>
                                                <span class="priority-badge @maintenance.Priority.ToLower()">@maintenance.Priority</span>
                                                <span class="activity-time">@maintenance.CreatedAt.ToString("MMM dd, HH:mm")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="no-data">No recent maintenance</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Performance Tables - Responsive Layout -->
        <div class="row mb-5">
            <div class="col-xl-6 col-lg-12 mb-4">
                <div class="card performance-card h-100">
                    <div class="card-header">
                        <h5><i class="fas fa-trophy me-2"></i>Top Performing Vehicles</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table performance-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Vehicle</th>
                                        <th class="d-none d-md-table-cell">Distance</th>
                                        <th class="d-none d-sm-table-cell">Trips</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.VehiclePerformance.Any())
                                    {
                                        @foreach (var vehicle in Model.VehiclePerformance.Take(5))
                                        {
                                            <tr>
                                                <td>
                                                    <div class="vehicle-info">
                                                        <div class="fw-bold">@vehicle.LicensePlate</div>
                                                        <small class="text-muted d-none d-sm-block">@vehicle.Model</small>
                                                    </div>
                                                </td>
                                                <td class="d-none d-md-table-cell">@vehicle.TotalDistance.ToString("N0") km</td>
                                                <td class="d-none d-sm-table-cell">@vehicle.TotalTrips</td>
                                                <td><span class="status-badge @vehicle.Status.ToLower()">@vehicle.Status</span></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="4" class="text-center text-muted">No data available</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-12 mb-4">
                <div class="card performance-card h-100">
                    <div class="card-header">
                        <h5><i class="fas fa-star me-2"></i>Top Performing Drivers</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table performance-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Driver</th>
                                        <th class="d-none d-md-table-cell">Distance</th>
                                        <th class="d-none d-sm-table-cell">Trips</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.DriverPerformance.Any())
                                    {
                                        @foreach (var driver in Model.DriverPerformance.Take(5))
                                        {
                                            <tr>
                                                <td>
                                                    <div class="driver-info">
                                                        <div class="fw-bold">@driver.Name</div>
                                                        <small class="text-muted d-none d-sm-block">@driver.LicenseNumber</small>
                                                    </div>
                                                </td>
                                                <td class="d-none d-md-table-cell">@driver.TotalDistance.ToString("N0") km</td>
                                                <td class="d-none d-sm-table-cell">@driver.TotalTrips</td>
                                                <td><span class="status-badge @driver.Status.ToLower()">@driver.Status</span></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="4" class="text-center text-muted">No data available</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Report Generator Modal - Responsive -->
<div class="modal fade" id="reportGeneratorModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-file-export me-2"></i>
                    Generate Custom Report
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="reportForm">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">Report Type</label>
                            <select class="form-select" name="reportType" required>
                                <option value="">Select Report Type</option>
                                <option value="trips">Trips Report</option>
                                <option value="vehicles">Vehicles Report</option>
                                <option value="drivers">Drivers Report</option>
                                <option value="maintenance">Maintenance Report</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3 mb-3">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control" name="startDate">
                        </div>
                        <div class="col-12 col-md-3 mb-3">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-control" name="endDate">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer flex-column flex-sm-row">
                <button type="button" class="btn btn-secondary mb-2 mb-sm-0" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="generateReport()">
                    <i class="fas fa-download me-2"></i>Generate Report
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        // Animate numbers on page load
        document.addEventListener('DOMContentLoaded', function() {
            animateNumbers();
            initializeCharts();
        });

        function animateNumbers() {
            const numbers = document.querySelectorAll('.stats-card .number, .kpi-card .number');
            numbers.forEach(function(number) {
                const target = parseFloat(number.textContent.replace(/[^\d.-]/g, ''));
                let current = 0;
                const duration = 2000;
                const startTime = performance.now();
                
                function animate(currentTime) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const easeOutQuart = 1 - Math.pow(1 - progress, 4);
                    current = target * easeOutQuart;
                    
                    if (number.textContent.includes('%')) {
                        number.textContent = current.toFixed(1) + '%';
                    } else if (number.textContent.includes(',')) {
                        number.textContent = Math.floor(current).toLocaleString();
                    } else {
                        number.textContent = Math.floor(current);
                    }
                    
                    if (progress < 1) {
                        requestAnimationFrame(animate);
                    }
                }
                
                requestAnimationFrame(animate);
            });
        }

        function initializeCharts() {
            // Responsive chart options
            const responsiveOptions = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { 
                        display: true,
                        position: 'bottom',
                        labels: {
                            boxWidth: 12,
                            padding: 15,
                            usePointStyle: true
                        }
                    } 
                },
                scales: { 
                    y: { 
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString();
                            }
                        }
                    },
                    x: {
                        ticks: {
                            maxRotation: 45,
                            minRotation: 0
                        }
                    }
                }
            };

            // Trips Chart
            const tripsCtx = document.getElementById('tripsChart').getContext('2d');
            new Chart(tripsCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TripsPerMonthLabels)),
                    datasets: [{
                        label: 'Trips',
                        data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TripsPerMonthData)),
                        borderColor: '#007bff',
                        backgroundColor: 'rgba(0, 123, 255, 0.1)',
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#007bff',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4
                    }]
                },
                options: responsiveOptions
            });

            // Orders Chart
            const ordersCtx = document.getElementById('ordersChart').getContext('2d');
            new Chart(ordersCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.OrdersPerMonthLabels)),
                    datasets: [{
                        label: 'Orders',
                        data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.OrdersPerMonthData)),
                        backgroundColor: '#28a745',
                        borderColor: '#20c997',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: responsiveOptions
            });

            // Vehicle Status Chart
            const vehicleStatusCtx = document.getElementById('vehicleStatusChart').getContext('2d');
            new Chart(vehicleStatusCtx, {
                type: 'pie',
                data: {
                    labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.VehicleStatusLabels)),
                    datasets: [{
                        data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.VehicleStatusData)),
                        backgroundColor: ['#007bff', '#28a745', '#ffc107', '#dc3545', '#6f42c1'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 15,
                                usePointStyle: true
                            }
                        }
                    }
                }
            });

            // Driver Status Chart
            const driverStatusCtx = document.getElementById('driverStatusChart').getContext('2d');
            new Chart(driverStatusCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DriverStatusLabels)),
                    datasets: [{
                        data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DriverStatusData)),
                        backgroundColor: ['#17a2b8', '#fd7e14', '#6c757d', '#dc3545'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 15,
                                usePointStyle: true
                            }
                        }
                    }
                }
            });
        }

        function generateReport() {
            const form = document.getElementById('reportForm');
            const formData = new FormData(form);
            
            if (!formData.get('reportType')) {
                alert('Please select a report type');
                return;
            }

            // Get CSRF token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const data = {
                reportType: formData.get('reportType'),
                startDate: formData.get('startDate') || null,
                endDate: formData.get('endDate') || null
            };

            fetch('/Reports/GenerateReport', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    ...data,
                    __RequestVerificationToken: token
                })
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(result => {
                if (result.success) {
                    downloadReport(result.data, data.reportType);
                    bootstrap.Modal.getInstance(document.getElementById('reportGeneratorModal')).hide();
                } else {
                    alert('Error generating report: ' + result.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error generating report: ' + error.message);
            });
        }

        function downloadReport(data, reportType) {
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${reportType}_report_${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
        }

        function exportToPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            
            doc.setFontSize(20);
            doc.text('SmartFleet Reports & Statistics', 20, 20);
            
            doc.setFontSize(12);
            doc.text(`Generated on: ${new Date().toLocaleDateString()}`, 20, 30);
            
            // Add statistics
            let yPos = 50;
            doc.text('Key Performance Indicators:', 20, yPos);
            yPos += 10;
            doc.text(`Fleet Utilization: @Model.FleetUtilizationPercentage%`, 25, yPos);
            yPos += 8;
            doc.text(`Driver Efficiency: @Model.DriverEfficiencyPercentage%`, 25, yPos);
            yPos += 8;
            doc.text(`Total Distance: @Model.TotalDistanceTraveled km`, 25, yPos);
            
            doc.save('smartfleet_report.pdf');
        }

        // Handle window resize for charts
        window.addEventListener('resize', function() {
            // Reinitialize charts on resize for better responsiveness
            setTimeout(function() {
                const charts = Chart.getChart ? Object.values(Chart.instances) : [];
                charts.forEach(chart => {
                    if (chart) {
                        chart.resize();
                    }
                });
            }, 100);
        });
    </script>
} 