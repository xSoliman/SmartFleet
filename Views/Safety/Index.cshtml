@{
    ViewData["Title"] = "Driver Monitoring";
}

<div class="monitor-container">
    <h2><i class="fas fa-eye me-2"></i>Driver Monitoring System</h2>

    <form asp-action="StartMonitoring" method="post">
        <button type="submit" class="btn btn-danger">
            <i class="fas fa-play me-2"></i>Start Monitoring
        </button>
    </form>

    @if (TempData["Message"] != null)
    {
        <p class="message text-success">
            <i class="fas fa-check-circle me-1"></i>@TempData["Message"]
        </p>
    }
</div>

<style>
    .monitor-container {
        max-width: 600px;
        margin: 50px auto;
        background-color: #fdfdfd;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    h2 {
        color: #2c3e50;
        text-align: center;
        margin-bottom: 30px;
    }

    .btn-danger {
        width: 100%;
        padding: 12px;
        font-size: 18px;
    }

    .message {
        margin-top: 20px;
        font-size: 16px;
        text-align: center;
    }
</style>
