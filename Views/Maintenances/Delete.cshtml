@model SmartFleet.Models.Maintenance

@{
    ViewData["Title"] = "Delete Maintenance";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/maintenance/form.css">
</head>

<div class="maintenance-layout-container">
    <div class="maintenance-form-wrapper">
        <div class="maintenance-navigation">
            <a asp-action="Index" class="maintenance-back-link">
                <i class="fas fa-arrow-left"></i> Back to Maintenance
            </a>
        </div>
        <h1 class="maintenance-heading"><i class="fas fa-exclamation-triangle"></i> Delete Maintenance</h1>
        <h3 style="text-align:center; color:#b71c1c; margin-bottom:24px;">Are you sure you want to delete this maintenance record?</h3>
        <div class="maintenance-details-display-group">
            <label class="maintenance-details-display-label">Vehicle</label>
            <div class="maintenance-details-display-value">@Model?.Vehicle?.LicensePlate ?? "N/A"</div>
        </div>
        <div class="maintenance-details-display-group">
            <label class="maintenance-details-display-label">Reported User</label>
            <div class="maintenance-details-display-value">@Model?.ReportedUser?.UserName ?? "N/A"</div>
        </div>
        <div class="maintenance-details-display-group">
            <label class="maintenance-details-display-label">Issue Description</label>
            <div class="maintenance-details-display-value">@Model.IssueDescription</div>
        </div>
        <div class="maintenance-details-display-group">
            <label class="maintenance-details-display-label">Repair Status</label>
            <div class="maintenance-details-display-value">
                <span class="maintenance-badge-status maintenance-badge-@Model.RepairStatus.ToString().ToLower()">
                    @Model.RepairStatus.ToString().Replace("_", " ")
                </span>
            </div>
        </div>
        <div class="maintenance-details-display-group">
            <label class="maintenance-details-display-label">Priority</label>
            <div class="maintenance-details-display-value">
                <span class="maintenance-badge-status maintenance-badge-@Model.Priority.ToString().ToLower()">
                    @Model.Priority.ToString().Replace("_", " ")
                </span>
            </div>
        </div>
        <div class="maintenance-details-display-group">
            <label class="maintenance-details-display-label">Repaired At</label>
            <div class="maintenance-details-display-value">@Model.RepairedAt?.ToString("yyyy-MM-dd") ?? "Not yet repaired"</div>
        </div>
        <div class="maintenance-details-display-group">
            <label class="maintenance-details-display-label">Created At</label>
            <div class="maintenance-details-display-value">@Model.CreatedAt.ToString("yyyy-MM-dd")</div>
        </div>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="maintenance-button-group" style="margin-top:24px;">
                <input type="submit" value="Delete" class="maintenance-primary-button" style="background:#b71c1c;" />
                <a asp-action="Index" class="maintenance-primary-button" style="background:#757575; margin-left:12px;">Cancel</a>
            </div>
        </form>
    </div>
</div>
