@model List<SmartFleet.Models.Vehicle>
@using SmartFleet.Services
@using SmartFleet.Services.Interfaces
@using Microsoft.AspNetCore.Identity
@inject IUserRoleService UserRoleService
@inject UserManager<SmartFleet.Models.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Vehicles Needing Maintenance";
    var currentUser = await UserManager.GetUserAsync(User);
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var isMaintenanceManager = userRoles.Contains("MaintenanceManager");
    var isFleetManager = userRoles.Contains("FleetManager");
    var isSysSupport = userRoles.Contains("SysSupport");
    var canCreateMaintenance = currentUser != null && await UserRoleService.CanCreateMaintenance(currentUser);
    var canEditMaintenance = currentUser != null && await UserRoleService.CanEditMaintenance(currentUser);
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/maintenance/form.css">
    <link rel="stylesheet" href="~/css/pages/maintenance/list.css">
</head>

<div class="maintenance-layout-container" style="background: #f8f9fa; min-height: 100vh; padding: 20px;">
    <div class="maintenance-form-wrapper">
        <!-- Header -->
        <div class="maintenance-vehicles-container">
            <div class="maintenance-vehicles-header">
                <h2 class="maintenance-vehicles-title">
                    <i class="fas fa-tools"></i>
                    Vehicles Needing Maintenance
                </h2>
                <div class="maintenance-vehicles-actions-header">
                    <a asp-action="Index" class="btn-back-to-maintenance">
                        <i class="fas fa-list"></i>
                        Back to Maintenance Records
                    </a>
                </div>
            </div>

            <!-- Table -->
            <div class="maintenance-vehicles-table">
                @if (Model != null && Model.Any())
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>
                                    <i class="fas fa-car me-2"></i>
                                    Vehicle Information
                                </th>
                                <th>
                                    <i class="fas fa-cogs me-2"></i>
                                    Vehicle Type
                                </th>
                                @if (isMaintenanceManager && canCreateMaintenance)
                                {
                                    <th>
                                        <i class="fas fa-clipboard-list me-2"></i>
                                        Actions
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vehicle in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="vehicle-info">
                                            <div class="vehicle-license">@vehicle.LicensePlate</div>
                                            <div class="vehicle-model">@vehicle.Model</div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="vehicle-type">@vehicle.Type</span>
                                    </td>
                                    @if (isMaintenanceManager && canCreateMaintenance)
                                    {
                                        <td>
                                            @{
                                                var hasActiveMaintenance = vehicle.Maintenances != null && vehicle.Maintenances.Any();
                                                var activeMaintenance = hasActiveMaintenance ? vehicle.Maintenances.First() : null;
                                            }
                                            @if (hasActiveMaintenance)
                                            {
                                                <div class="maintenance-actions-group">
                                                    <button class="btn-maintenance-created" disabled>
                                                        <i class="fas fa-check-circle"></i>
                                                        <span style="color: #ffffff;">Maintenance Record Created</span>
                                                    </button>
                                                    @if ((isMaintenanceManager || isSysSupport) && canEditMaintenance)
                                                    {
                                                        <a class="btn-edit-maintenance" 
                                                           asp-controller="Maintenances" 
                                                           asp-action="Edit" 
                                                           asp-route-id="@activeMaintenance.Id">
                                                            <i class="fas fa-edit" style="color: white !important;"></i>
                                                            Edit
                                                        </a>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <a class="btn-add-maintenance-report" 
                                                   asp-controller="Maintenances" 
                                                   asp-action="CreateMaintenance" 
                                                   asp-route-VehicleId="@vehicle.Id">
                                                    <i class="fas fa-plus-circle"></i>
                                                    Add Maintenance Report
                                                </a>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="no-vehicles-message">
                        <i class="fas fa-check-circle"></i>
                        <p>No vehicles currently need maintenance.</p>
                        <p>All vehicles are in good condition!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
