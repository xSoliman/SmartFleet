@model List<SmartFleet.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicles Under Maintenance";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        .custom-table thead {
            background-color: #2c3e50;
            color: white;
        }

        .custom-table tbody tr:nth-child(odd) {
            background-color: #f9f9f9;
        }

        .custom-table tbody tr:hover {
            background-color: #f1f1f1;
        }

        h2 {
            margin-bottom: 30px;
            font-weight: bold;
            color: #34495e;
        }

        .form-control, select {
            font-size: 0.9rem;
        }

        .btn-primary {
            background-color: #3498db;
            border: none;
        }

        .btn-success {
            background-color: #2ecc71;
            border: none;
        }

        .table-container {
            padding: 30px;
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

    </style>
</head>

<div class="container table-container mt-4">
    <h2><i class="fas fa-tools me-2"></i>Vehicles Under Maintenance</h2>

    <table class="table table-bordered custom-table">
        <thead>
            <tr>
                <th><i class="fas fa-car me-1"></i>License Plate</th>
                <th><i class="fas fa-cogs me-1"></i>Model</th>
                <th><i class="fas fa-wrench me-1"></i>Status</th>
                <th><i class="fas fa-clipboard-list me-1"></i>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vehicle in Model)
            {
                <tr>
                    <td>@vehicle.LicensePlate</td>
                    <td>@vehicle.Model</td>
                    <td>
                        <form asp-action="UpdateVehicleStatus" method="post" class="d-flex flex-column">
                            <input type="hidden" name="vehicleId" value="@vehicle.Id" />
                            <select name="newStatus" class="form-select form-select-sm mb-1">
                                @foreach (var status in Enum.GetValues(typeof(SmartFleet.Models.VehicleState)))
                                {
                                    <option value="@status" selected="@(vehicle.Status == (VehicleState)status)">
                                        @status
                                    </option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="fas fa-sync-alt me-1"></i>Update
                            </button>
                        </form>
                    </td>
                    <td>
                        <a class="btn btn-sm btn-success" asp-controller="Maintenances" asp-action="CreateMaintenance" asp-route-VehicleId="@vehicle.Id">
                            <i class="fas fa-plus-circle me-1"></i>Add Maintenance
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
