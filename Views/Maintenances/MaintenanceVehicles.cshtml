@model List<SmartFleet.Models.Vehicle>
@using SmartFleet.Services
@using SmartFleet.Services.Interfaces
@using Microsoft.AspNetCore.Identity
@inject IUserRoleService UserRoleService
@inject UserManager<SmartFleet.Models.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Vehicles Needing Maintenance";
    var currentUser = await UserManager.GetUserAsync(User);
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var isMaintenanceManager = userRoles.Contains("MaintenanceManager");
    var isFleetManager = userRoles.Contains("FleetManager");
    var isSysSupport = userRoles.Contains("SysSupport");
    var canCreateMaintenance = currentUser != null && await UserRoleService.CanCreateMaintenance(currentUser);
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/maintenance/form.css">
    <link rel="stylesheet" href="~/css/pages/maintenance/list.css">
</head>

<div class="maintenance-layout-container" style="background: #f8f9fa; min-height: 100vh;">
    <div class="maintenance-form-wrapper">
        <div class="maintenance-header" style="border-bottom: 1px solid #e9ecef; margin-bottom: 24px;">
            <div>
                <h2 class="maintenance-heading" style="text-align:left;"><i class="fas fa-tools me-2"></i>Vehicles Needing Maintenance</h2>
            </div>
            <div class="maintenance-actions">
                <a asp-action="Index" class="maintenance-primary-button" style="background:#757575;">
                    <i class="fas fa-list"></i> All Maintenance Records
                </a>
            </div>
        </div>
        <div class="table-responsive" style="margin-top: 10px;">
            <table class="table table-bordered" style="background:#fff; border-radius:10px; overflow:hidden;">
                <thead style="background:#f5f7fa;">
                    <tr>
                        <th><i class="fas fa-car me-1"></i>License Plate</th>
                        <th><i class="fas fa-cogs me-1"></i>Model</th>
                        <th><i class="fas fa-clipboard-list me-1"></i>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vehicle in Model)
                    {
                        <tr>
                            <td>@vehicle.LicensePlate</td>
                            <td>@vehicle.Model</td>
                            <td>
                                @if (isMaintenanceManager && canCreateMaintenance)
                                {
                                    <a class="maintenance-primary-button" style="background:#20B2AA; padding:8px 16px; font-size:15px;" asp-controller="Maintenances" asp-action="CreateMaintenance" asp-route-VehicleId="@vehicle.Id">
                                        <i class="fas fa-plus-circle me-1"></i>Add Maintenance Report
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
