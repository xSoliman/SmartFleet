@model List<SmartFleet.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicles Under Maintenance";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/maintenance/form.css">
    <link rel="stylesheet" href="~/css/pages/maintenance/list.css">
</head>

<div class="maintenance-layout-container" style="background: #f8f9fa; min-height: 100vh;">
    <div class="maintenance-form-wrapper">
        <div class="maintenance-header" style="border-bottom: 1px solid #e9ecef; margin-bottom: 24px;">
            <div>

                <h2 class="maintenance-heading" style="text-align:left;"><i class="fas fa-tools me-2"></i>Vehicles Needing Maintenance</h2>
            </div>
            <div class="maintenance-actions">
                <a asp-action="Index" class="maintenance-primary-button" style="background:#757575;">
                    <i class="fas fa-list"></i> All Maintenance Records
                </a>
        
            </div>
        </div>
        <div class="table-responsive" style="margin-top: 10px;">
            <table class="table table-bordered" style="background:#fff; border-radius:10px; overflow:hidden;">
                <thead style="background:#f5f7fa;">
                    <tr>
                        <th><i class="fas fa-car me-1"></i>License Plate</th>
                        <th><i class="fas fa-cogs me-1"></i>Model</th>
                        <th><i class="fas fa-wrench me-1"></i>Status</th>
                        <th><i class="fas fa-clipboard-list me-1"></i>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vehicle in Model)
                    {
                        <tr>
                            <td>@vehicle.LicensePlate</td>
                            <td>@vehicle.Model</td>
                            <td>
                                <form asp-action="UpdateVehicleStatus" method="post" class="d-flex flex-column">
                                    <input type="hidden" name="vehicleId" value="@vehicle.Id" />
                                    <select name="newStatus" class="maintenance-dropdown mb-1" style="max-width:180px;">
                                        @foreach (var status in Enum.GetValues(typeof(SmartFleet.Models.VehicleState)))
                                        {
                                            var statusText = status.ToString();
                                            statusText = System.Text.RegularExpressions.Regex.Replace(statusText, "([a-z])([A-Z])", "$1 $2");
                                            if (statusText == "On Scheduled Trip")
                                            {
                                                statusText = "Scheduled Trip";
                                            }
                                            <option value="@status" selected="@(vehicle.Status == (VehicleState)status)">@statusText</option>
                                        }
                                    </select>
                                    <button type="submit" class="maintenance-primary-button" style="background:#3498db; padding:6px 12px; font-size:15px;">
                                        <i class="fas fa-sync-alt me-1"></i>Update
                                    </button>
                                </form>
                            </td>
                            <td>
                                <a class="maintenance-primary-button" style="background:#20B2AA; padding:6px 12px; font-size:15px;" asp-controller="Maintenances" asp-action="CreateMaintenance" asp-route-VehicleId="@vehicle.Id">
                                    <i class="fas fa-plus-circle me-1"></i>Add Maintenance
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
