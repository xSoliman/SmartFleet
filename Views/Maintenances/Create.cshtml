@model SmartFleet.Models.Maintenance

@{
    ViewData["Title"] = "Create Maintenance";
    
    // Ensure ViewBag data is available
    if (ViewBag.VehicleInfo == null)
    {
        ViewBag.VehicleInfo = null;
    }
    if (ViewBag.UserInfo == null)
    {
        ViewBag.UserInfo = null;
    }
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/maintenance/form.css">
</head>

<div class="maintenance-layout-container">
    <div class="maintenance-form-wrapper">
        <div class="maintenance-navigation">
            <a asp-action="Index" class="maintenance-back-link">
                <i class="fas fa-arrow-left"></i> Back to Maintenance
            </a>
        </div>
        <h1 class="maintenance-heading">Create Maintenance</h1>
        <form asp-action="Create" method="post" class="maintenance-custom-form">
            <div asp-validation-summary="All" class="maintenance-validation-message"></div>

            <div class="maintenance-input-group">
                <label class="maintenance-input-label">Vehicle</label>
                @if (Model.VehicleId > 0)
                {
                    var vehicle = ViewBag.VehicleInfo as SmartFleet.Models.Vehicle;
                    if (vehicle != null)
                    {
                        <input type="text" class="maintenance-input-field" value="@vehicle.LicensePlate - @vehicle.Model" readonly />
                    }
                    else
                    {
                        <input type="text" class="maintenance-input-field" value="Vehicle ID: @Model.VehicleId (Vehicle not found)" readonly />
                    }
                }
                else
                {
                    <select asp-for="VehicleId" class="maintenance-dropdown" asp-items="ViewBag.VehicleId">
                        <option value="">-- Select Vehicle --</option>
                    </select>
                }
                    <input type="hidden" asp-for="VehicleId" />
                <span asp-validation-for="VehicleId" class="maintenance-validation-message"></span>
                </div>

            <div class="maintenance-input-group">
                <label class="maintenance-input-label">Reported By</label>
                @if (!string.IsNullOrEmpty(Model.ReportedBy))
                {
                    var user = ViewBag.UserInfo as SmartFleet.Models.ApplicationUser;
                    if (user != null)
                    {
                        <input type="text" class="maintenance-input-field" value="@user.UserName (@user.Email)" readonly />
                    }
                    else
                    {
                        <input type="text" class="maintenance-input-field" value="User ID: @Model.ReportedBy (User not found)" readonly />
                    }
                }
                else
                {
                    <select asp-for="ReportedBy" class="maintenance-dropdown" asp-items="ViewBag.ReportedBy">
                        <option value="">-- Select User --</option>
                    </select>
                }
                    <input type="hidden" asp-for="ReportedBy" />
                <span asp-validation-for="ReportedBy" class="maintenance-validation-message"></span>
                </div>

            <div class="maintenance-input-group">
                <label asp-for="IssueDescription" class="maintenance-input-label">Issue Description</label>
                <textarea asp-for="IssueDescription" class="maintenance-input-field" rows="3" placeholder="Describe the maintenance issue..."></textarea>
                <span asp-validation-for="IssueDescription" class="maintenance-validation-message"></span>
                    </div>

            <div class="maintenance-input-row">
                <div class="maintenance-input-group">
                    <label asp-for="RepairStatus" class="maintenance-input-label">Repair Status</label>
                    <select asp-for="RepairStatus" class="maintenance-dropdown" asp-items="Html.GetEnumSelectList<RepairState>()"></select>
                    <span asp-validation-for="RepairStatus" class="maintenance-validation-message"></span>
                </div>
                <div class="maintenance-input-group">
                    <label asp-for="Priority" class="maintenance-input-label">Priority</label>
                    <select asp-for="Priority" class="maintenance-dropdown" asp-items="Html.GetEnumSelectList<PriorityDegree>()"></select>
                    <span asp-validation-for="Priority" class="maintenance-validation-message"></span>
                    </div>
                </div>

            <div class="maintenance-input-row">
                <div class="maintenance-input-group">
                    <label asp-for="RepairedAt" class="maintenance-input-label">Repaired At (Optional)</label>
                    <input asp-for="RepairedAt" class="maintenance-input-field" type="datetime-local" />
                    <span asp-validation-for="RepairedAt" class="maintenance-validation-message"></span>
                </div>
                <div class="maintenance-input-group">
                    <label asp-for="CreatedAt" class="maintenance-input-label">Created At</label>
                    <input asp-for="CreatedAt" class="maintenance-input-field" type="datetime-local" />
                    <span asp-validation-for="CreatedAt" class="maintenance-validation-message"></span>
                </div>
            </div>

            <div class="maintenance-button-group">
                <button type="submit" class="maintenance-primary-button">
                    <i class="fas fa-plus"></i> Create Maintenance
                </button>
                </div>
            </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
