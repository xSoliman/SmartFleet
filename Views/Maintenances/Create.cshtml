@model SmartFleet.Models.Maintenance

@{
    ViewData["Title"] = "Create Maintenance";}

<link rel="stylesheet" href="~/css/pages/maintenance/create.css" />

<div class="container mt-4">
    <div class="card shadow-sm rounded">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Create Maintenance</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Vehicle ID</label>
                    <input type="text" class="form-control" value="@Model.VehicleId" readonly />
                    <input type="hidden" asp-for="VehicleId" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Reported By (User ID)</label>
                    <input type="text" class="form-control" value="@Model.ReportedBy" readonly />
                    <input type="hidden" asp-for="ReportedBy" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="RepairStatus" class="form-label"></label>
                        <select asp-for="RepairStatus" class="form-select" asp-items="Html.GetEnumSelectList<RepairState>()"></select>
                        <span asp-validation-for="RepairStatus" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Priority" class="form-label"></label>
                        <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<PriorityDegree>()"></select>
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="RepairedAt" class="form-label"></label>
                        <input asp-for="RepairedAt" class="form-control" type="date" />
                        <span asp-validation-for="RepairedAt" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CreatedAt" class="form-label"></label>
                        <input asp-for="CreatedAt" class="form-control" type="date" />
                        <span asp-validation-for="CreatedAt" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueDescription" class="form-label"></label>
                    <textarea asp-for="IssueDescription" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="IssueDescription" class="text-danger"></span>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-success">Create</button>
                    <a asp-action="MaintenanceVehicles" class="btn btn-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
