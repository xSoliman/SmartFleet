@model SmartFleet.Models.SimCard
@{
    ViewData["Title"] = "Sim Card Details";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/simcard/details.css">
</head>

<div class="details-layout-container">
    <div class="details-form-wrapper">
        <!-- Navigation Back Button -->
        <div class="details-navigation">
            <a asp-action="Index" class="details-back-link">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>

        <!-- Heading -->
        <h1 class="details-heading">SimCard Details</h1>

        <!-- Status Badge -->
        <div class="details-status-section">
            <div class="details-status-badge @(Model.Status == SimCardStatus.Active ? "status-active" : "status-inactive")">
                <i class="fas fa-circle"></i>
                @Model.Status
            </div>
        </div>

        <!-- Main Information Card -->
        <div class="details-info-card">
            <div class="details-card-header">
                <i class="fas fa-sim-card"></i>
                <h3>SimCard Information</h3>
            </div>
            
            <div class="details-info-grid">
                <div class="details-display-group">
                    <label class="details-display-label">
                        <i class="fas fa-sim-card"></i> Sim Number
                    </label>
                    <div class="details-display-value">@Html.DisplayFor(model => model.SimNumber)</div>
                </div>

                <div class="details-display-group">
                    <label class="details-display-label">
                        <i class="fas fa-network-wired"></i> Carrier
                    </label>
                    <div class="details-display-value">@Html.DisplayFor(model => model.Carrier)</div>
                </div>

                <div class="details-display-group">
                    <label class="details-display-label">
                        <i class="fas fa-toggle-on"></i> Status
                    </label>
                    <div class="details-display-value">
                        <span class="details-status-text @(Model.Status == SimCardStatus.Active ? "status-active-text" : "status-inactive-text")">
                            @Html.DisplayFor(model => model.Status)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Information Card -->
        <div class="details-info-card">
            <div class="details-card-header">
                <i class="fas fa-info-circle"></i>
                <h3>System Information</h3>
            </div>
            
            <div class="details-info-grid">
                <div class="details-display-group">
                    <label class="details-display-label">
                        <i class="fas fa-calendar-plus"></i> Created At
                    </label>
                    <div class="details-display-value">
                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="details-display-group">
                    <label class="details-display-label">
                        <i class="fas fa-fingerprint"></i> ID
                    </label>
                    <div class="details-display-value">@Model.Id</div>
                </div>
            </div>
        </div>

        <!-- GPS Tracking Information -->
        <div class="details-info-card">
            <div class="details-card-header">
                <i class="fas fa-satellite"></i>
                <h3>GPS Tracking Status</h3>
            </div>
            
            <div class="details-gps-info">
                @if (Model.Status == SimCardStatus.Active)
                {
                    <div class="details-gps-status active">
                        <i class="fas fa-check-circle"></i>
                        <div class="details-gps-text">
                            <h4>GPS Tracking Ready</h4>
                            <p>This SimCard is active and ready for GPS tracking. Make sure it's assigned to a vehicle.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="details-gps-status inactive">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div class="details-gps-text">
                            <h4>GPS Tracking Disabled</h4>
                            <p>This SimCard is inactive. Set status to "Active" to enable GPS tracking.</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="details-button-group">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="details-primary-button">
                <i class="fas fa-edit"></i> Edit SimCard
            </a>
            <a asp-action="Index" class="details-secondary-button">
                <i class="fas fa-list"></i> Back to List
            </a>
        </div>
    </div>
</div>