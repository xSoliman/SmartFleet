@model SmartFleet.Models.SimCard

@{
    ViewData["Title"] = "Create Sim Card";
}
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/simcard/create.css">
</head>

<div class="layout-container">
    <div class="form-wrapper">
        <div class="navigation">
            <a asp-action="Index" class="back-link">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
        
        <h1 class="page-title">Create Sim Card</h1>
        
        <!-- Setup Guide -->
        <div class="setup-guide">
            <h3><i class="fas fa-info-circle"></i> GPS Tracking Setup Guide</h3>
            <div class="guide-content">
                <p><strong>For GPS tracking to work:</strong></p>
                <ol>
                    <li>Enter the SimCard number from your GPS device</li>
                    <li>Set Status to "Active"</li>
                    <li>Assign this SimCard to a vehicle after creation</li>
                </ol>
                <div class="example-data">
                    <p><strong>Example:</strong></p>
                    <ul>
                        <li><strong>Sim Number:</strong> 01505932589</li>
                        <li><strong>Carrier:</strong> WE Egypt</li>
                        <li><strong>Status:</strong> Active</li>
                    </ul>
                </div>
            </div>
        </div>

        <form asp-action="Create" class="custom-form">
            <div asp-validation-summary="ModelOnly" class="validation-message"></div>

            <div class="input-row">
                <div class="input-col">
                    <div class="input-group">
                        <label asp-for="SimNumber" class="input-label">
                            <i class="fas fa-sim-card"></i> Sim Number *
                        </label>
                        <input asp-for="SimNumber" class="text-input" placeholder="e.g., 01505932589" />
                        <span asp-validation-for="SimNumber" class="validation-message"></span>
                        <small class="help-text">Enter the SimCard number from your GPS device</small>
                    </div>
                </div>
                <div class="input-col">
                    <div class="input-group">
                        <label asp-for="Carrier" class="input-label">
                            <i class="fas fa-network-wired"></i> Carrier *
                        </label>
                        <select asp-for="Carrier" class="custom-select">
                            <option value="">Select Carrier</option>
                            <option value="WE Egypt">WE Egypt</option>
                            <option value="Orange Egypt">Orange Egypt</option>
                            <option value="Vodafone Egypt">Vodafone Egypt</option>
                            <option value="Etisalat Egypt">Etisalat Egypt</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Carrier" class="validation-message"></span>
                        <small class="help-text">Select your mobile network carrier</small>
                    </div>
                </div>
            </div>

            <div class="input-row">
                <div class="input-col">
                    <div class="input-group">
                        <label asp-for="Status" class="input-label">
                            <i class="fas fa-toggle-on"></i> Status *
                        </label>
                        <select asp-for="Status" class="custom-select">
                            <option value="Inactive">Inactive</option>
                            <option value="Active" selected>Active</option>
                        </select>
                        <span asp-validation-for="Status" class="validation-message"></span>
                        <small class="help-text">Must be "Active" for GPS tracking to work</small>
                    </div>
                </div>
            </div>

            <!-- Important Notice -->
            <div class="important-notice">
                <div class="notice-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="notice-content">
                    <h4>Important:</h4>
                    <p>After creating this SimCard, you must assign it to a vehicle for GPS tracking to work.</p>
                    <p>Go to <strong>Vehicles → Select Vehicle → SimCard tab</strong> to complete the setup.</p>
                </div>
            </div>

            <div class="button-group">
                <button type="submit" class="primary-button">
                    <i class="fas fa-plus"></i> Create SimCard
                </button>
                <a asp-action="Index" class="secondary-button">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
