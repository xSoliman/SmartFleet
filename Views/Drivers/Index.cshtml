@model IEnumerable<SmartFleet.Models.Driver>

@{
    ViewData["Title"] = "Drivers";
}

<head>
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/driver/list.css">
    
</head>
<div class="add-driver mb-3">
    <a asp-action="Create" class="btn btn-add-car">
        <i class="fas fa-user-plus driver-icon"></i> Add Driver
    </a>
</div>
<div class="driver-filter-bar">
    <form asp-action="Index" method="get">
        <div class="form-group mx-2">
            <input type="text" name="searchUserName" value="@Context.Request.Query["searchUserName"]" class="form-control form-control-sm" placeholder="Search Username" />
        </div>
        <div class="form-group mx-2">
            <input type="text" name="searchLicense" value="@Context.Request.Query["searchLicense"]" class="form-control form-control-sm" placeholder="Search License Number" />
        </div>
        <div class="form-group mx-2">
            <select name="statusFilter" class="form-control form-control-sm">
                <option value="">All Statuses</option>
                @foreach (SmartFleet.Models.DriverState state in Enum.GetValues(typeof(SmartFleet.Models.DriverState)))
                {
                    <option value="@state" selected="@(Context.Request.Query["statusFilter"] == state.ToString() ? "selected" : null)">@state</option>
                }
            </select>
        </div>
        <div class="driver-filter-actions">
            <button type="submit" class="btn btn-sm custom-btn">
                <i class="fas fa-filter"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-sm btn-secondary ms-2">Clear</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-driver table-bordered">
        <thead>
            <tr>
            <th>Profile Image</th>
            <th>UserName</th>
            <th>Email</th>
            <th>License Number</th>
            <th>License Expiry</th>
            <th>Status</th>
            <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var driver in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(driver.ProfileImageUrl))
                    {
                        <img src="@driver.ProfileImageUrl" alt="Profile Image" width="50" height="50" />
                    }
                </td>
                <td>@driver.UserName</td>
                <td>@driver.Email</td>
                <td>@driver.LicenseNumber</td>
                <td>@driver.LicenseExpiryDate.ToShortDateString()</td>
                <td>
                    <span class="badge-status badge-@driver.DriverStatus.ToString().ToLower()">
                        @driver.DriverStatus
                    </span>
                </td>
       
                    <td>
                        <a asp-action="Edit" asp-route-id="@driver.Id" class="btn edit">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@driver.Id" class="btn details">
                            <i class="fas fa-info-circle"></i> Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@driver.Id" class="btn delete">
                            <i class="fas fa-trash-alt deleted_icon"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
