@model SmartFleet.Models.Driver

@{
    ViewData["Title"] = "Driver Dashboard";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        .dashboard-container {
            padding: 30px;
            background-color: #fdfdfd;
            border-radius: 16px;
            box-shadow: 0 0 15px rgba(0,0,0,0.08);
            margin-top: 30px;
        }

        h2, h4 {
            color: #2c3e50;
        }

        .status-section {
            background-color: #ecf0f1;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 30px;
        }

        .btn-primary {
            background-color: #2980b9;
            border: none;
        }

        .table thead {
            background-color: #2c3e50;
            color: white;
        }

        .table tbody tr:hover {
            background-color: #f5f5f5;
        }

        .no-trips {
            color: #888;
            font-style: italic;
        }
    </style>
</head>

<div class="container dashboard-container">
    <h2><i class="fas fa-user-circle me-2"></i>Welcome, <strong>@Model.UserName</strong></h2>

    <div class="status-section mt-4">
        <h4><i class="fas fa-toggle-on me-2"></i>Update Driver Status</h4>
        <form asp-action="UpdateDriverStatus" method="post" class="row g-3">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-md-6">
                <label class="form-label">Driver Status</label>
                <select name="status" class="form-select">
                    @foreach (DriverState item in Enum.GetValues(typeof(DriverState)))
                    {
                        var selected = item == Model.DriverStatus ? "selected" : "";
                        @:<option value="@item" @selected>@item</option>
                    }
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-sync-alt me-1"></i>Update Status
                </button>
            </div>
        </form>
    </div>

    <hr />

    <h4><i class="fas fa-route me-2"></i>Trips Assigned</h4>
    @if (Model.Trips != null && Model.Trips.Any())
    {
        <table class="table table-bordered table-hover mt-3">
            <thead>
                <tr>
                    <th><i class="fas fa-map-marker-alt me-1"></i>Start</th>
                    <th><i class="fas fa-flag-checkered me-1"></i>End</th>
                    <th><i class="fas fa-info-circle me-1"></i>Status</th>
                    <th><i class="fas fa-road me-1"></i>Distance (km)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trip in Model.Trips)
                {
                    <tr>
                        <td>@trip.StartLocation</td>
                        <td>@trip.EndLocation</td>
                        <td>@trip.Status</td>
                        <td>@trip.Distance</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="no-trips"><i class="fas fa-info-circle me-1"></i>No trips assigned yet.</p>
    }
</div>
