@model SmartFleet.ViewModel.DriverViewModel
@{
    ViewData["Title"] = "Edit Driver";
}


<head>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/driver/edit.css">
    
</head>
<div class="edit-layout-container">
    <div class="edit-form-wrapper">
        <!-- Navigation Back Button -->
        <div class="edit-navigation">
            <a asp-action="Index" class="edit-back-link">
                <i class="fas fa-arrow-left"></i> Back to Drivers
            </a>
        </div>

        <!-- Heading -->
        <h1 class="edit-heading">Edit Driver</h1>

        <!-- Form -->
        <form asp-action="Edit" class="edit-custom-form" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="edit-validation-message"></div>
            <input type="hidden" asp-for="Id" />

            <div class="edit-input-group">
                <label asp-for="UserName" class="edit-input-label">Username</label>
                <input asp-for="UserName" class="edit-input-field" placeholder="Enter username" />
                <span asp-validation-for="UserName" class="edit-validation-message"></span>
            </div>

            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label asp-for="Email" class="edit-input-label">Email Address</label>
                    <input asp-for="Email" class="edit-input-field" type="email" placeholder="Enter email address" />
                    <span asp-validation-for="Email" class="edit-validation-message"></span>
                </div>
                <div class="edit-input-group">
                    <label asp-for="Password" class="edit-input-label">Password</label>
                    <input asp-for="Password" class="edit-input-field" type="password" placeholder="Enter new password" />
                    <span asp-validation-for="Password" class="edit-validation-message"></span>
                    <small class="form-text text-muted">
                        Leave blank to keep the current password.
                    </small>
                </div>
            </div>

            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label asp-for="LicenseNumber" class="edit-input-label">License Number</label>
                    <input asp-for="LicenseNumber" class="edit-input-field" placeholder="Enter license number" />
                    <span asp-validation-for="LicenseNumber" class="edit-validation-message"></span>
                </div>
                <div class="edit-input-group">
                    <label asp-for="LicenseExpiryDate" class="edit-input-label">License Expiry Date</label>
                    <input asp-for="LicenseExpiryDate" class="edit-input-field" type="date" />
                    <span asp-validation-for="LicenseExpiryDate" class="edit-validation-message"></span>
                </div>
            </div>

            <div class="edit-input-group">
                <label asp-for="DriverStatus" class="edit-input-label">Driver Status</label>
                <select asp-for="DriverStatus" class="edit-dropdown">
                    @foreach (var status in Enum.GetValues(typeof(SmartFleet.Models.DriverState)))
                    {
                        var statusText = status.ToString();
                        // Add spaces before capital letters for better readability
                        statusText = System.Text.RegularExpressions.Regex.Replace(statusText, "([a-z])([A-Z])", "$1 $2");
                        
                        // Use shorter text for the long status
                        if (statusText == "Assigned On Scheduled Trip")
                        {
                            statusText = "Scheduled Trip";
                        }
                        
                        <option value="@status" selected="@(status.Equals(Model.DriverStatus) ? "selected" : null)">@statusText</option>
                    }
                </select>
                <span asp-validation-for="DriverStatus" class="edit-validation-message"></span>
            </div>

            <div class="edit-input-group">
                <label asp-for="ProfileImageFile" class="edit-input-label">Profile Image</label>
                <input type="file" asp-for="ProfileImageFile" class="edit-input-field" accept="image/*" onchange="previewImage(event)" />
                <span asp-validation-for="ProfileImageFile" class="edit-validation-message"></span>
                <div class="image-preview-container">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img id="imagePreview" class="image-preview show" src="@Model.ImageUrl" alt="Current profile image" />
                        <div id="noImageText" class="no-image-text" style="display: none;">No image selected</div>
                    }
                    else
                    {
                        <img id="imagePreview" class="image-preview" src="" alt="Profile image preview" />
                        <div id="noImageText" class="no-image-text">No image selected</div>
                    }
                </div>
            </div>

            <div class="edit-button-group">
                <button type="submit" class="edit-primary-button">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Scripts Section -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/driver/edit.js"></script>
}