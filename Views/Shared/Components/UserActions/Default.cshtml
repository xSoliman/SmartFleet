@model SmartFleet.ViewComponents.UserActionsViewModel

@if (Model.IsAuthenticated)
{
    @if (Model.HasAccessToDashboard)
    {
        <a asp-controller="Home" asp-action="Dashboard" class="btn btn-lg btn-secondary me-2" title="Dashboard">Dashboard</a>
    }
    <a asp-controller="Account" asp-action="MyAccount" class="btn btn-lg btn-primary my-account-btn me-2">My Account <i class="fas fa-user"></i></a>
    <a asp-controller="Account" asp-action="Logout" class="btn btn-lg btn-outline-danger">Logout <i class="fas fa-sign-out-alt"></i></a>
}
else
{
    <a asp-controller="Account" asp-action="Login" class="btn btn-lg btn-primary me-2"><i class="fas fa-sign-in-alt"></i> Sign In</a>
    <a asp-controller="Account" asp-action="Register" class="btn btn-lg btn-success"><i class="fas fa-user-plus"></i> Sign Up</a>
} 