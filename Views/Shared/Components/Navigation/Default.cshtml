@model SmartFleet.ViewComponents.NavigationViewModel

<div class="navbar-nav mx-auto py-0">
    <a asp-controller="Home" asp-action="Index" class="nav-item nav-link @(Model.CurrentController == "Home" ? "active" : "")">Home</a>

    <!-- Orders - Always visible, locked based on privileges -->
    <div class="nav-item dropdown">
        <a asp-controller="Orders" asp-action="Index" class="nav-link dropdown-toggle @(Model.CurrentController == "Orders" ? "active" : "") @(!Model.HasAccessToOrders ? "text-muted" : "")" 
           title="@(!Model.HasAccessToOrders ? "Access restricted - Contact administrator" : "")">
            Orders
            @if (!Model.HasAccessToOrders)
            {
                <i class="fas fa-lock ms-1" style="font-size: 0.8em;"></i>
            }
        </a>
        <div class="dropdown-menu m-0">
            <a asp-controller="Orders" asp-action="Index" class="dropdown-item @(!Model.HasAccessToOrders ? "text-muted" : "")">All Order</a>
            <a asp-controller="Orders" asp-action="Create" class="dropdown-item @(!Model.HasAccessToOrders ? "text-muted" : "")">Create New Order</a>
        </div>
    </div>

