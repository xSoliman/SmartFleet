@model SmartFleet.ViewComponents.NavigationViewModel

<div class="navbar-nav mx-auto py-0">
    @if (Model.IsAuthenticated)
    {
        <a asp-controller="Home" asp-action="Index" class="nav-item nav-link @(Model.CurrentController == "Home" ? "active" : "")" style="font-size: 1.1rem;">Home</a>
    }
    
    @if (Model.HasAccessToOrders)
    {
        <span class="nav-separator mx-3">|</span>
        <!-- Orders -->
        <a asp-controller="Orders" asp-action="Index" class="nav-item nav-link @(Model.CurrentController == "Orders" ? "active" : "")" style="font-size: 1.1rem;">
            Orders
        </a>
    }
    
    @if (Model.HasAccessToTrips)
    {
        <span class="nav-separator mx-3">|</span>
        <!-- Trips -->
        <a asp-controller="Trips" asp-action="Index" class="nav-item nav-link @(Model.CurrentController == "Trips" ? "active" : "")" style="font-size: 1.1rem;">
            Trips
        </a>
    }
    
    @if (Model.HasAccessToMaintenance)
    {
        <span class="nav-separator mx-3">|</span>
        <!-- Maintenance -->
        <a asp-controller="Maintenances" asp-action="Index" class="nav-item nav-link @(Model.CurrentController == "Maintenances" ? "active" : "")" style="font-size: 1.1rem;">
            Maintenance
        </a>
    }
    
    @if (Model.HasAccessToVehicles)
    {
        <span class="nav-separator mx-3">|</span>
        <!-- Vehicles -->
        <a asp-controller="Vehicles" asp-action="Index" class="nav-item nav-link @(Model.CurrentController == "Vehicles" ? "active" : "")" style="font-size: 1.1rem;">
            Vehicles
        </a>
    }
    
    @if (Model.HasAccessToDrivers)
    {
        <span class="nav-separator mx-3">|</span>
        <!-- Drivers -->
        <a asp-controller="Drivers" asp-action="Index" class="nav-item nav-link @(Model.CurrentController == "Drivers" ? "active" : "")" style="font-size: 1.1rem;">
            Drivers
        </a>
    }
    
    @if (Model.HasAccessToTracking)
    {
        <span class="nav-separator mx-3">|</span>
        <!-- Tracking -->
        <a asp-controller="Tracking" asp-action="Index" class="nav-item nav-link @(Model.CurrentController == "Tracking" ? "active" : "")" style="font-size: 1.1rem;">
            Tracking
        </a>
    }
    
   
</div> 