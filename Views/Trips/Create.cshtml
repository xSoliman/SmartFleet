@model SmartFleet.Models.Trip

@{
    ViewData["Title"] = "Create Trip";
}

<link rel="stylesheet" href="~/css/pages/trip/create.css">

<div class="create-layout-container">
    <div class="create-form-wrapper">
        <a href="javascript:history.back()" class="create-back-link mb-3">
            <i class="fas fa-arrow-left"></i> Back
        </a>
        <h1 class="create-heading">Create New Trip</h1>
        <form asp-action="Create" class="create-custom-form needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="create-validation-message"></div>
            <div class="flex-row">
                <div class="flex-col-2">
                    <div class="create-input-group">
                        <label asp-for="OrderId" class="create-input-label">Order ID</label>
                        <input type="text" class="create-input-field" value="@ViewBag.OrderId" readonly />
                        <input type="hidden" asp-for="OrderId" value="@ViewBag.OrderId" />
                    </div>
                    <div class="create-input-group">
                        <label asp-for="CreatedBy" class="create-input-label">Created By</label>
                        <input type="text" class="create-input-field" value="@ViewBag.CreatedBy" readonly />
                        <input type="hidden" asp-for="CreatedBy" value="@ViewBag.CreatedBy" />
                    </div>
                    <div class="create-input-group">
                        <label asp-for="VehicleId" class="create-input-label">Vehicle</label>
                        <select asp-for="VehicleId" class="create-dropdown" asp-items="@ViewBag.VehicleId" required>
                            <option value="">-- Select Vehicle --</option>
                        </select>
                        <span asp-validation-for="VehicleId" class="create-validation-message"></span>
                    </div>
                    <div class="create-input-group">
                        <label asp-for="DriverId" class="create-input-label">Driver</label>
                        <select asp-for="DriverId" class="create-dropdown" asp-items="ViewBag.DriverId" required>
                            <option value="">-- Select Driver --</option>
                        </select>
                        <span asp-validation-for="DriverId" class="create-validation-message"></span>
                    </div>
                </div>
                <div class="flex-col-2">
                    <div class="create-input-group">
                        <label asp-for="Status" class="create-input-label">Trip Status</label>
                        <select asp-for="Status" class="create-dropdown" asp-items="Html.GetEnumSelectList<TripState>()" required>
                            <option value="">-- Select Status --</option>
                        </select>
                        <span asp-validation-for="Status" class="create-validation-message"></span>
                    </div>
                    <div class="create-input-group">
                        <label class="create-input-label">Start Location</label>
                        <input class="create-input-field" value="@ViewBag.OrderStartLocation" readonly />
                    </div>
                    <div class="create-input-group">
                        <label class="create-input-label">End Location</label>
                        <input class="create-input-field" value="@ViewBag.OrderEndLocation" readonly />
                    </div>
                </div>
            </div>
            <div class="create-info-box">
                <div class="info-icon">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div class="info-content">
                    <h4>Auto-Calculated Distance</h4>
                    <p>The trip distance will be automatically calculated based on GPS tracking data when the trip is in progress. No manual input required.</p>
                </div>
            </div>
            <div class="create-button-group">
                <button type="submit" class="create-primary-button">
                    <i class="fas fa-save me-1"></i> Create Trip
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
