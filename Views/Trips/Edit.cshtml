@model SmartFleet.Models.Trip

@{
    ViewData["Title"] = "Edit Trip";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/trip/edit.css">
    <link rel="stylesheet" href="~/css/pages/trip/searchable-dropdowns.css">
</head>
<div class="edit-layout-container">
    <div class="edit-form-wrapper">
        <!-- Navigation Back Button -->
        <div class="edit-navigation">
            <a asp-action="Index" class="edit-back-link">
                <i class="fas fa-arrow-left"></i> Back to Trips
            </a>
        </div>
        <!-- Heading -->
        <h1 class="edit-heading">Edit Trip</h1>
        <!-- Form -->
        <form asp-action="Edit" class="edit-custom-form">
            <div asp-validation-summary="All" class="edit-validation-message"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="Distance" />
            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label asp-for="VehicleId" class="edit-input-label">Vehicle</label>
                    <select asp-for="VehicleId" class="edit-dropdown" asp-items='@(ViewData["VehicleId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)'></select>
                    <span asp-validation-for="VehicleId" class="edit-validation-message"></span>
                </div>
                <!-- Geofence Display Block -->
                <div class="edit-input-group">
                    @if (ViewBag.VehicleGeofence != null)
                    {
                        <span class="badge bg-info text-dark"><i class="fas fa-map-marker-alt"></i> Geofence: <b>@ViewBag.VehicleGeofence.Name</b> (@ViewBag.VehicleGeofence.Type)</span>
                        <a href="/Geofences/Index" target="_blank" class="btn btn-sm btn-outline-info ms-2"><i class="fas fa-cogs"></i> Manage Geofence</a>
                    }
                    else
                    {
                        <span class="text-warning"><i class="fas fa-exclamation-circle"></i> No geofence assigned to this vehicle.</span>
                    }
                </div>
            </div>
            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label asp-for="DriverId" class="edit-input-label">Driver</label>
                    <select asp-for="DriverId" class="edit-dropdown" asp-items='@(ViewData["DriverId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)'></select>
                    <span asp-validation-for="DriverId" class="edit-validation-message"></span>
                </div>
            </div>
            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label class="edit-input-label">Status</label>
                    <input type="text" class="form-control" value="@Model.Status" readonly />
                </div>
            </div>
            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle"></i>
                <strong>Note:</strong> Trip dates are managed through the associated Order. Distance is automatically calculated based on GPS tracking data.
            </div>
            <div class="edit-button-group mt-3">
                <button type="submit" class="edit-primary-button">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
        @if (Model.Status != SmartFleet.Models.TripState.Cancelled)
        {
            <form asp-action="Cancel" method="post" style="margin-top:10px;">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-warning btn-sm" 
                        onclick="return confirm('Are you sure you want to cancel this trip?')">
                    <i class="fas fa-times"></i> Cancel trip
                </button>
            </form>
        }
    </div>
    <div class="edit-form-wrapper right-card-info">
        <div class="card order-info-card">
            <div class="card-header">
                <i class="fas fa-file-alt"></i>
                <h5>Order Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-5"><i class="fas fa-hashtag"></i> Order ID</dt>
                    <dd class="col-7">@ViewBag.OrderId</dd>
                    <dt class="col-5"><i class="fas fa-user"></i> Ordered By</dt>
                    <dd class="col-7">@ViewBag.CreatedByUserName</dd>
                    <dt class="col-5"><i class="fas fa-clock"></i> Start Time</dt>
                    <dd class="col-7">@((ViewBag.TripStartTime != null) ? ((DateTime)ViewBag.TripStartTime).ToString("dd/MM/yyyy HH:mm") : "-")</dd>
                    <dt class="col-5"><i class="fas fa-clock"></i> End Time</dt>
                    <dd class="col-7">@((ViewBag.TripEndTime != null) ? ((DateTime)ViewBag.TripEndTime).ToString("dd/MM/yyyy HH:mm") : "-")</dd>
                    <dt class="col-5"><i class="fas fa-map-marker-alt"></i> From</dt>
                    <dd class="col-7">@ViewBag.OrderStartLocation</dd>
                    <dt class="col-5"><i class="fas fa-map-marker-alt"></i> To</dt>
                    <dd class="col-7">@ViewBag.OrderEndLocation</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/trip/searchable-dropdowns.js"></script>
    <script>
        $(document).ready(function() {
            // Basic form validation and functionality
            $('.edit-dropdown').on('change', function() {
                validateField($(this));
            });
            
            // Form submission handling
            $('.edit-custom-form').on('submit', function(e) {
                if (!validateForm()) {
                    e.preventDefault();
                    return false;
                }
            });
        });
        
        function validateField(field) {
            const value = field.val();
            const validationSpan = field.siblings('.edit-validation-message');
            
            field.removeClass('is-valid is-invalid');
            
            if (!value || value.trim() === '') {
                field.addClass('is-invalid');
                validationSpan.text('This field is required.');
                return false;
            } else {
                field.addClass('is-valid');
                validationSpan.text('');
                return true;
            }
        }
        
        function validateForm() {
            let isValid = true;
            
            $('.edit-dropdown[required]').each(function() {
                if (!validateField($(this))) {
                    isValid = false;
                }
            });
            
            return isValid;
        }
    </script>
}
