@model SmartFleet.ViewModel.TripViewModel

@{
    ViewData["Title"] = "Trips";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/trip/list.css">
</head>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="order-filter-bar">
    <form asp-action="Index" method="get" class="d-flex align-items-center flex-wrap gap-2 w-100">
        <div class="form-group mx-2">
            <input type="text" name="destination" value="@Model.Destination" class="form-control form-control-sm" placeholder="Destination" />
        </div>
        <div class="form-group mx-2">
            <input type="text" name="searchDriverName" value="@Model.SearchDriverName" class="form-control form-control-sm" placeholder="Driver Name" />
        </div>
        <div class="form-group mx-2">
            <select name="vehicleType" class="form-control form-control-sm">
                <option value="">All Vehicle Types</option>
                @foreach (SmartFleet.Models.VehicleType type in Enum.GetValues(typeof(SmartFleet.Models.VehicleType)))
                {
                    <option value="@type" selected="@(Model.VehicleType == type ? "selected" : null)">@type</option>
                }
            </select>
        </div>
        <div class="form-group mx-2">
            <select name="stateFilter" class="form-control form-control-sm">
                <option value="">All Statuses</option>
                @foreach (SmartFleet.Models.TripState state in Enum.GetValues(typeof(SmartFleet.Models.TripState)))
                {
                    <option value="@state" selected="@(Model.StateFilter == state ? "selected" : null)">@state</option>
                }
            </select>
        </div>
        <div class="form-group mx-2">
            <label for="startDate" class="form-label">From:</label>
            <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="form-group mx-2">
            <label for="endDate" class="form-label">To:</label>
            <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="order-filter-actions">
            <button type="submit" class="btn btn-sm custom-btn">
                <i class="fas fa-filter"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-sm btn-secondary ms-2">Clear</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-order table-bordered">
    <thead>
        <tr>
                <th>Vehicle</th>
                <th>Driver</th>
                <th>Trip Start Date</th>
                <th>Trip End Date</th>
                <th>Distance</th>
                <th>Destination</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Created By</th>
                <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@if (Model.Trips != null)
{
    foreach (var item in Model.Trips) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Vehicle.Model) (@Html.DisplayFor(modelItem => item.Vehicle.Type))</td>
            <td>@Html.DisplayFor(modelItem => item.Driver.UserName)</td>
            <td>@Html.DisplayFor(modelItem => item.Order.TripStartDate)</td>
            <td>@Html.DisplayFor(modelItem => item.Order.TripEndDate)</td>
            <td>@Html.DisplayFor(modelItem => item.Distance) km</td>
            <td>@Html.DisplayFor(modelItem => item.Order.Destination)</td>
            <td>
                <span class="badge-status badge-@item.Status.ToString().ToLower()">
                    @item.Status
                </span>
            </td>
            <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
            <td>@Html.DisplayFor(modelItem => item.CreatedByUser.UserName)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-edit">
                    <i class="fas fa-edit edit-icon"></i> Edit
                </a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-details">
                    <i class="fas fa-info-circle"></i> Details
                </a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-delete">
                    <i class="fas fa-trash-alt deleted_icon"></i> Delete
                </a>
                
                @if (item.Status == TripState.Scheduled || item.Status == TripState.InProgress)
                {
                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning" 
                                onclick="return confirm('Are you sure you want to cancel this trip?')">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
}
    </tbody>
</table>
</div>
