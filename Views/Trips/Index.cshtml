@model SmartFleet.ViewModel.TripViewModel

@{
    ViewData["Title"] = "Trips";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/trip/list.css">
</head>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.IsDriver)
{
    <h3 class="assigned-trips-header text-center">Assigned Trips</h3>
    <div class="order-filter-bar">
        <form asp-action="Index" method="get" class="d-flex align-items-center flex-wrap gap-2 w-100">
            <div class="form-group mx-2">
                <input type="text" name="assignedDestination" value="@Model.AssignedDestination" class="form-control form-control-sm" placeholder="Destination" />
            </div>
            <div class="form-group mx-2">
                <input type="text" name="assignedSearchDriverName" value="@Model.AssignedSearchDriverName" class="form-control form-control-sm" placeholder="Driver Name" />
            </div>
            <div class="form-group mx-2">
                <select name="assignedVehicleType" class="form-control form-control-sm">
                    <option value="">All Vehicle Types</option>
                    @foreach (SmartFleet.Models.VehicleType type in Enum.GetValues(typeof(SmartFleet.Models.VehicleType)))
                    {
                        <option value="@type" selected="@(Model.AssignedVehicleType == type ? "selected" : null)">@type</option>
                    }
                </select>
            </div>
            <div class="form-group mx-2">
                <select name="assignedStateFilter" class="form-control form-control-sm">
                    <option value="">All Statuses</option>
                    @foreach (SmartFleet.Models.TripState state in Enum.GetValues(typeof(SmartFleet.Models.TripState)))
                    {
                        <option value="@state" selected="@(Model.AssignedStateFilter == state ? "selected" : null)">@state</option>
                    }
                </select>
            </div>
            <div class="form-group mx-2 d-flex align-items-end gap-2">
                <div>
                    <label for="assignedStartDate" class="form-label">From:</label>
                    <input type="date" name="assignedStartDate" value="@(Model.AssignedStartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div>
                    <label for="assignedEndDate" class="form-label">To:</label>
                    <input type="date" name="assignedEndDate" value="@(Model.AssignedEndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="order-filter-actions">
                <button type="submit" class="btn btn-sm custom-btn">
                    <i class="fas fa-filter"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-sm btn-secondary ms-2">Clear</a>
            </div>
            <!-- Keep ordered trips filters in hidden fields so they persist -->
            <input type="hidden" name="destination" value="@Model.Destination" />
            <input type="hidden" name="searchDriverName" value="@Model.SearchDriverName" />
            <input type="hidden" name="vehicleType" value="@Model.VehicleType" />
            <input type="hidden" name="stateFilter" value="@Model.StateFilter" />
            <input type="hidden" name="startDate" value="@Model.StartDate" />
            <input type="hidden" name="endDate" value="@Model.EndDate" />
        </form>
    </div>
    <div class="table-responsive assigned-trips-table">
        <table class="table table-order table-bordered">
            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Trip Start Date</th>
                    <th>Trip End Date</th>
                    <th>Destination</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.AssignedTrips != null && Model.AssignedTrips.Any())
            {
                foreach (var item in Model.AssignedTrips)
                {
                    <tr>
                        <td>@item.Vehicle.LicensePlate (@item.Vehicle.Type)</td>
                        <td>@item.Order.TripStartDate.ToString("MM/dd/yyyy HH:mm")</td>
                        <td>@item.Order.TripEndDate.ToString("MM/dd/yyyy HH:mm")</td>
                        <td>@item.Order.Destination</td>
                        <td>
                            <span class="badge-status badge-@item.Status.ToString().ToLower()">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-details btn-sm">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No assigned trips found.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    @if (Model.IsNormalUser)
    {
        <h3 class="my-trips-header text-center">My Trip Orders</h3>
    }
    else if (Model.IsFleetManager || Model.IsSysSupport)
    {
        <h3 class="all-trips-header text-center">All Trips</h3>
    }
    else
    {
        <h3 class="trips-header text-center">Trips</h3>
    }

    <div class="order-filter-bar">
        <form asp-action="Index" method="get" class="d-flex align-items-center flex-wrap gap-2 w-100">
            <div class="form-group mx-2">
                <input type="text" name="destination" value="@Model.Destination" class="form-control form-control-sm" placeholder="Destination" />
            </div>
            <div class="form-group mx-2">
                <input type="text" name="searchDriverName" value="@Model.SearchDriverName" class="form-control form-control-sm" placeholder="Driver Name" />
            </div>
            <div class="form-group mx-2">
                <select name="vehicleType" class="form-control form-control-sm">
                    <option value="">All Vehicle Types</option>
                    @foreach (SmartFleet.Models.VehicleType type in Enum.GetValues(typeof(SmartFleet.Models.VehicleType)))
                    {
                        <option value="@type" selected="@(Model.VehicleType == type ? "selected" : null)">@type</option>
                    }
                </select>
            </div>
            <div class="form-group mx-2">
                <select name="stateFilter" class="form-control form-control-sm">
                    <option value="">All Statuses</option>
                    @foreach (SmartFleet.Models.TripState state in Enum.GetValues(typeof(SmartFleet.Models.TripState)))
                    {
                        <option value="@state" selected="@(Model.StateFilter == state ? "selected" : null)">@state</option>
                    }
                </select>
            </div>
            <div class="form-group mx-2 d-flex align-items-end gap-2">
                <div>
                    <label for="startDate" class="form-label">From:</label>
                    <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div>
                    <label for="endDate" class="form-label">To:</label>
                    <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="order-filter-actions">
                <button type="submit" class="btn btn-sm custom-btn">
                    <i class="fas fa-filter"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-sm btn-secondary ms-2">Clear</a>
            </div>
            <!-- Keep assigned trips filters in hidden fields so they persist -->
            <input type="hidden" name="assignedDestination" value="@Model.AssignedDestination" />
            <input type="hidden" name="assignedSearchDriverName" value="@Model.AssignedSearchDriverName" />
            <input type="hidden" name="assignedVehicleType" value="@Model.AssignedVehicleType" />
            <input type="hidden" name="assignedStateFilter" value="@Model.AssignedStateFilter" />
            <input type="hidden" name="assignedStartDate" value="@Model.AssignedStartDate" />
            <input type="hidden" name="assignedEndDate" value="@Model.AssignedEndDate" />
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-order table-bordered">
        <thead>
            <tr>
                <th>Vehicle</th>
                <th>Driver</th>
                <th>Trip Start Date</th>
                <th>Trip End Date</th>
                <th>Destination</th>
                <th>Status</th>
                @if (Model.IsFleetManager || Model.IsSysSupport)
                {
                    <th>Ordered By</th>
                }
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
    @if (Model.Trips != null)
    {
        foreach (var item in Model.Trips) {
            <tr>
                <td>@item.Vehicle.LicensePlate (@item.Vehicle.Type)</td>
                <td>@item.Driver.UserName</td>
                <td>@item.Order.TripStartDate.ToString("MM/dd/yyyy HH:mm")</td>
                <td>@item.Order.TripEndDate.ToString("MM/dd/yyyy HH:mm")</td>
                <td>@item.Order.Destination</td>
                <td>
                    <span class="badge-status badge-@item.Status.ToString().ToLower()">
                        @item.Status
                    </span>
                </td>
                @if (Model.IsFleetManager || Model.IsSysSupport)
                {
                    <td>@item.CreatedByUser.UserName</td>
                }
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-details btn-sm">
                        <i class="fas fa-info-circle"></i> Details
                    </a>

                    @if (item.Status == TripState.Scheduled || item.Status == TripState.InProgress)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-edit btn-sm">
                            <i class="fas fa-edit edit-icon"></i> Edit
                        </a>
                    }
                    
                    @if (Model.IsSysSupport)
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-delete btn-sm">
                            <i class="fas fa-trash-alt deleted_icon"></i> Delete
                        </a>
                    }
                    
                    @if (item.Status == TripState.Scheduled)
                    {
                        <form asp-action="Cancel" asp-route-id="@item.Id" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning btn-sm" 
                                    onclick="return confirm('Are you sure you want to cancel this trip?')">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    }
        </tbody>
    </table>
    </div>
}

<!-- Pagination Controls -->
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new {
                        pageNumber = i,
                        destination = ViewBag.Destination,
                        searchDriverName = ViewBag.SearchDriverName,
                        vehicleType = ViewBag.VehicleType,
                        stateFilter = ViewBag.StateFilter,
                        startDate = ViewBag.StartDate,
                        endDate = ViewBag.EndDate
                    })">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}

