@model SmartFleet.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/vehicle/details.css">
</head>

<div class="details-layout-container">
    <div class="details-form-wrapper">
        <!-- Navigation Back Button -->
        <div class="details-navigation">
            <a asp-action="Index" class="details-back-link">
                <i class="fas fa-arrow-left"></i> Back to Vehicles
            </a>
        </div>

        <!-- Heading -->
        <h1 class="details-heading">Vehicle Details</h1>

        <!-- Vehicle Image Section at Top -->
        <div class="profile-image-section">
            @if (!string.IsNullOrEmpty(Model.VehicleImageUrl))
            {
                <img src="@Model.VehicleImageUrl" alt="Vehicle Image" class="profile-image" />
            }
            else
            {
                <div class="profile-image-placeholder">
                    <i class="fas fa-car" style="font-size: 80px; color: #ccc;"></i>
                </div>
            }
        </div>

        <!-- Display Data -->
        <div class="details-display-group">
            <label class="details-display-label">Model</label>
            <div class="details-display-value">@Model.Model</div>
        </div>

        <div class="details-display-group">
            <label class="details-display-label">Type</label>
            <div class="details-display-value">@Model.Type</div>
        </div>

        <div class="details-display-group">
            <label class="details-display-label">Capacity</label>
            <div class="details-display-value">@Model.Capacity</div>
        </div>

        <div class="details-display-group">
            <label class="details-display-label">License Plate</label>
            <div class="details-display-value">@Model.LicensePlate</div>
        </div>

        <div class="details-display-group">
            <label class="details-display-label">Total Distance Traveled</label>
            <div class="details-display-value">@Model.TotalDistanceTraveled.ToString("F1") km</div>
        </div>

        <div class="details-display-group">
            <label class="details-display-label">Registration Expiry Date</label>
            <div class="details-display-value">@(Model.RegistrationExpiryDate?.ToString("dd/MM/yyyy") ?? "Not set")</div>
        </div>

        <div class="details-display-group">
            <label class="details-display-label">Status</label>
            <div class="details-display-value">
                @{
                    var statusText = Model.Status.ToString();
                    // Replace underscores with spaces and capitalize first letter of each word
                    statusText = statusText.Replace("_", " ");
                    statusText = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(statusText.ToLower());
                    
                    // Use shorter text for the long status
                    if (statusText == "On Scheduled Trip")
                    {
                        statusText = "Scheduled Trip";
                    }
                }
                <span class="badge-status badge-@Model.Status.ToString().ToLower()">
                    @statusText
                </span>
            </div>
        </div>

        <div class="details-display-group">
            <label class="details-display-label">Created At</label>
            <div class="details-display-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
        </div>

        <div class="details-display-group">
            <label class="details-display-label">Updated At</label>
            <div class="details-display-value">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
        </div>

        <!-- Button Group -->
        <div class="details-button-group">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="details-primary-button">Edit</a>
        </div>
    </div>
</div>

