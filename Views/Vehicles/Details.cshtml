@model SmartFleet.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/vehicle/details.css">
</head>

<div class="main-container">
    <!-- Left Section: Sim Card Details and Vehicle Details -->
    <div class="left-container">
        <!-- Back Button -->
        <div class="details-navigation">
            <a asp-action="Index" class="details-back-link">
                <i class="fas fa-arrow-left"></i> Back to Vehicles
            </a>
        </div>

        <!-- Sim Card Details -->
        <div class="sim-card-container">
            <div class="sim-card-data">
                <h2>Sim Card Data</h2>
                <p><strong>Sim Number:</strong> <span id="simNumber">@(Model.SimCard?.SimNumber ?? "Not assigned")</span></p>
                <p><strong>Carrier:</strong> <span id="carrier">@(Model.SimCard?.Carrier ?? "Not assigned")</span></p>
                <p><strong>Status:</strong> <span id="status">@(Model.SimCard?.Status.ToString() ?? "Not assigned")</span></p>
            </div>
            <div class="image-container">
                @if (!string.IsNullOrEmpty(Model.VehicleImageUrl))
                    {
                    <img src="@Model.VehicleImageUrl" alt="Vehicle Image">
                }
                else
                {
                    <img src="~/assets/images/icons/download.png" alt="Default Vehicle Image">
                }
            </div>
        </div>

        <!-- Vehicle Details -->
        <div class="vehicle-container">
            <h1 class="vehicle-heading">Vehicle Details</h1>
            <div class="vehicle-details">
                <div class="vehicle-item">
                    <span class="vehicle-label">Model:</span>
                    <span>@Model.Model</span>
                </div>
                <div class="vehicle-item">
                    <span class="vehicle-label">Type:</span>
                    <span>@Model.Type</span>
                </div>
                <div class="vehicle-item">
                    <span class="vehicle-label">Capacity:</span>
                    <span>@Model.Capacity</span>
                </div>
                <div class="vehicle-item">
                    <span class="vehicle-label">License Plate:</span>
                    <span>@Model.LicensePlate</span>
                </div>
                <div class="vehicle-item">
                    <span class="vehicle-label">Status:</span>
                    <span>
                        @{
                            var statusText = Model.Status.ToString();
                            // Replace underscores with spaces and capitalize first letter of each word
                            statusText = statusText.Replace("_", " ");
                            statusText = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(statusText.ToLower());
                            
                            // Use shorter text for the long status
                            if (statusText == "On Scheduled Trip")
                            {
                                statusText = "Scheduled Trip";
                            }
                        }
                        <span class="badge-status badge-@Model.Status.ToString().ToLower()">
                            @statusText
                        </span>
                    </span>
                </div>
                <div class="vehicle-item">
                    <span class="vehicle-label">Total Distance Traveled:</span>
                    <span>@Model.TotalDistanceTraveled.ToString("F2") km</span>
                </div>
                <div class="vehicle-item">
                    <span class="vehicle-label">Registration Expiry Date:</span>
                    <span>@(Model.RegistrationExpiryDate?.ToString("dd/MM/yyyy") ?? "Not set")</span>
                </div>
                <div class="vehicle-item">
                    <span class="vehicle-label">Created At:</span>
                    <span>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="vehicle-item">
                    <span class="vehicle-label">Updated At:</span>
                    <span>@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>

            <div class="vehicle-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="vehicle-button">Edit</a>
            </div>
        </div>
    </div>

    <!-- Right Sidebar Section -->
    <div class="right-container">
        <h2>Actions</h2>
        <ul>
            <li><a asp-action="Details" asp-route-id="@Model.Id" class="current-view"><i class="fa-solid fa-info"></i> Information</a></li>
            <li><a asp-action="Maintenance" asp-route-id="@Model.Id"><i class="fa-solid fa-wrench"></i> Maintenance</a></li>
            <li><a asp-action="SimCard" asp-route-id="@Model.Id"><i class="fa-solid fa-sim-card"></i> SimCard</a></li>
            <li><a asp-action="Tracking" asp-route-id="@Model.Id"><i class="fa-solid fa-location-dot"></i> Tracking</a></li>
        </ul>
    </div>
</div>

