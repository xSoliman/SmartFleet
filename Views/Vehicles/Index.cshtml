@model IEnumerable<SmartFleet.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicle List";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/vehicle/list.css">
</head>

<!-- Hidden form for anti-forgery token -->
<form id="antiForgeryForm" style="display: none;">
    @Html.AntiForgeryToken()
</form>

<p class="add-vehicle">
    <a asp-action="Create" class="btn btn-add-car"><i class="fas fa-car car-icon"></i> Add Vehicle</a>
</p>
<div class="vehicle-filter-bar">
    <form asp-action="Index" method="get" class="d-flex align-items-center flex-wrap gap-2 w-100">
        <div class="form-group mx-2">
            <input type="text" name="searchModel" value="@Context.Request.Query["searchModel"]" class="form-control form-control-sm" placeholder="Search Model" />
        </div>
        <div class="form-group mx-2">
            <input type="text" name="searchPlate" value="@Context.Request.Query["searchPlate"]" class="form-control form-control-sm" placeholder="Search Plate" />
        </div>
        <div class="form-group mx-2">
            <select name="typeFilter" class="form-control form-control-sm">
                <option value="">All Types</option>
                @foreach (SmartFleet.Models.VehicleType type in Enum.GetValues(typeof(SmartFleet.Models.VehicleType)))
                {
                    <option value="@type" selected="@(Context.Request.Query["typeFilter"] == type.ToString() ? "selected" : null)">@type</option>
                }
            </select>
        </div>
        <div class="form-group mx-2">
            <select name="stateFilter" class="form-control form-control-sm">
                <option value="">All Statuses</option>
                @foreach (SmartFleet.Models.VehicleState state in Enum.GetValues(typeof(SmartFleet.Models.VehicleState)))
                {
                    var statusText = state.ToString();
                    // Replace underscores with spaces and capitalize first letter of each word
                    statusText = statusText.Replace("_", " ");
                    statusText = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(statusText.ToLower());
                    
                    // Use shorter text for the long status
                    if (statusText == "On Scheduled Trip")
                    {
                        statusText = "Scheduled Trip";
                    }
                    
                    <option value="@state" selected="@(Context.Request.Query["stateFilter"] == state.ToString() ? "selected" : null)">@statusText</option>
                }
            </select>
        </div>
        <div class="vehicle-filter-actions">
            <button type="submit" class="btn btn-sm custom-btn">
                <i class="fas fa-filter"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-sm btn-secondary ms-2">Clear</a>
        </div>
    </form>
</div>
<div class="table-responsive">
    <table id="vehicle-table" class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Model)</th>
                <th>@Html.DisplayNameFor(model => model.Type)</th>
                <th>@Html.DisplayNameFor(model => model.Capacity)</th>
                <th>@Html.DisplayNameFor(model => model.LicensePlate)</th>
                <th>@Html.DisplayNameFor(model => model.TotalDistanceTraveled)</th>
                <th>@Html.DisplayNameFor(model => model.RegistrationExpiryDate)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
    
                    <td>@Html.DisplayFor(modelItem => item.Model)</td>
                    <td>@Html.DisplayFor(modelItem => item.Type)</td>
                    <td>@Html.DisplayFor(modelItem => item.Capacity)</td>
                    <td>@Html.DisplayFor(modelItem => item.LicensePlate)</td>
                 
                    <td>@(item.TotalDistanceTraveled.ToString("F2")) km</td>
                     
                    <td>@(item.RegistrationExpiryDate?.ToString("dd/MM/yyyy") ?? "Not set")</td>
                   
                       <td>
                        <span class="badge-status badge-@item.Status.ToString().ToLower()">
                            @{
                                var statusText = item.Status.ToString();
                                // Replace underscores with spaces and capitalize first letter of each word
                                statusText = statusText.Replace("_", " ");
                                statusText = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(statusText.ToLower());
                                
                                // Use shorter text for the long status
                                if (statusText == "On Scheduled Trip")
                                {
                                    statusText = "Scheduled Trip";
                                }
                            }
                            @statusText
                        </span>
                    </td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-edit">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-details">
                            <i class="fas fa-info-circle"></i> Details
                        </a>
                        <button type="button" class="btn btn-delete" onclick="deleteVehicle('@item.Id', '@item.Model')">
                            <i class="fas fa-trash-alt deleted_icon"></i>
                        </button>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
<br />

<!-- Pagination Controls -->
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { 
                        pageNumber = i, 
                        searchModel = ViewBag.SearchModel, 
                        searchPlate = ViewBag.SearchPlate, 
                        typeFilter = ViewBag.TypeFilter, 
                        stateFilter = ViewBag.StateFilter })">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script>
        function deleteVehicle(vehicleId, vehicleModel) {
            if (confirm('Are you sure you want to delete vehicle "' + vehicleModel + '"? This action cannot be undone.')) {
                // Create a form to submit the deletion
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Vehicles/Delete/' + vehicleId;
                
                // Add anti-forgery token from hidden form
                var token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
                if (token) {
                    var newToken = token.cloneNode(true);
                    form.appendChild(newToken);
                }
                
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}
