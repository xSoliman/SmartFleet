@model SmartFleet.Models.Vehicle
@using SmartFleet.Services.Interfaces
@using Microsoft.AspNetCore.Identity
@inject IUserRoleService UserRoleService
@inject UserManager<SmartFleet.Models.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Edit Vehicle";
    var currentUser = await UserManager.GetUserAsync(User);
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var isFleetManager = userRoles.Contains("FleetManager");
    var isMaintenanceManager = userRoles.Contains("MaintenanceManager");
    var isSysSupport = userRoles.Contains("SysSupport");
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/vehicle/edit.css">
    <style>
        button {
            color: white !important;
        }
        button * {
            color: white !important;
        }
        
        /* Need Maintenance Status Styling */
        .edit-status-need-maintenance {
            background-color: #fff3cd !important;
            border: 2px solid #ffc107 !important;
            color: #856404 !important;
            font-weight: 600 !important;
            text-transform: capitalize !important;
            box-shadow: 0 2px 4px rgba(255, 193, 7, 0.2) !important;
        }
        
        .edit-status-need-maintenance:focus {
            outline: none !important;
            border-color: #e0a800 !important;
            box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25) !important;
        }
    </style>
</head>

<div class="edit-layout-container">
    <div class="edit-form-wrapper">
        <!-- Navigation Back Button -->
        <div class="edit-navigation">
            <a asp-action="Index" class="edit-back-link">
                <i class="fas fa-arrow-left"></i> Back to Vehicles
            </a>
        </div>

        <!-- Heading -->
        <h1 class="edit-heading">Edit Vehicle</h1>

        <!-- Form -->
        <form asp-action="Edit" class="edit-custom-form" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="edit-validation-message"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SimCardId" />

            <div class="edit-input-group">
                <label asp-for="Model" class="edit-input-label">Vehicle Model</label>
                <input asp-for="Model" class="edit-input-field" placeholder="Enter vehicle model" />
                <span asp-validation-for="Model" class="edit-validation-message"></span>
            </div>

            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label asp-for="Type" class="edit-input-label">Vehicle Type</label>
                    <select asp-for="Type" class="edit-dropdown">
                        <option value="Car">Car</option>
                        <option value="Truck">Truck</option>
                        <option value="Bus">Bus</option>
                        <option value="Van">Van</option>
                        <option value="Motorcycle">Motorcycle</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Type" class="edit-validation-message"></span>
                </div>
                <div class="edit-input-group">
                    <label asp-for="Capacity" class="edit-input-label">Capacity</label>
                    <input asp-for="Capacity" class="edit-input-field" placeholder="Enter capacity" />
                    <span asp-validation-for="Capacity" class="edit-validation-message"></span>
                </div>
            </div>

            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label asp-for="LicensePlate" class="edit-input-label">License Plate</label>
                    <input asp-for="LicensePlate" class="edit-input-field" placeholder="Enter license plate" />
                    <span asp-validation-for="LicensePlate" class="edit-validation-message"></span>
                </div>
                <div class="edit-input-group">
                    <label asp-for="Status" class="edit-input-label">Maintenance Actions</label>
                    @if (isFleetManager)
                    {
                        <!-- Fleet Manager can toggle between available and need_maintenance -->
                        @if (Model.Status == VehicleState.available)
                        {
                            <input type="hidden" asp-for="Status" value="@VehicleState.need_maintenance" />
                            <button type="submit" class="edit-status-button edit-status-need-maintenance">
                                <i class="fas fa-wrench"></i> Mark as Need Maintenance
                            </button>
                        }
                        else if (Model.Status == VehicleState.maintained)
                        {
                            <input type="hidden" asp-for="Status" value="@VehicleState.available" />
                            <button type="submit" class="edit-status-button edit-status-available">
                                <i class="fas fa-check-circle"></i> Mark as Available
                            </button>
                        }
                        else if (Model.Status == VehicleState.need_maintenance)
                        {
                            <!-- For need_maintenance state, show read-only status with special styling -->
                            <input value="Need Maintenance" class="edit-input-field edit-status-need-maintenance" readonly />
                            <small class="edit-help-text">Vehicle needs maintenance. Cannot be changed by Fleet Manager.</small>
                        }
                        else
                        {
                            <!-- For other states, show current status as read-only -->
                            <input value="@Model.Status.ToString().Replace("_", " ")" class="edit-input-field" readonly style="background-color: #f8f9fa;" />
                            <small class="edit-help-text">Current state cannot be changed by Fleet Manager.</small>
                        }
                        <small class="edit-help-text">Fleet Manager can toggle between Available and Need Maintenance states.</small>
                    }
                    else if (isMaintenanceManager)
                    {
                        <!-- Maintenance Manager can only change to maintained -->
                        @if (Model.Status == VehicleState.need_maintenance)
                        {
                            <input type="hidden" asp-for="Status" value="@VehicleState.maintained" />
                            <button type="submit" class="edit-status-button edit-status-maintained">
                                <i class="fas fa-tools"></i> Mark as Maintained
                            </button>
                        }
                        else
                        {
                            <!-- For other states, show current status as read-only -->
                            <input value="@Model.Status.ToString().Replace("_", " ")" class="edit-input-field" readonly style="background-color: #f8f9fa;" />
                            <small class="edit-help-text">Maintenance Manager can only change vehicles from Need Maintenance to Maintained.</small>
                        }
                        <small class="edit-help-text">Maintenance Manager can only change vehicle state to Maintained.</small>
                    }
                    else if (isSysSupport)
                    {
                        <!-- SysSupport can change to any state -->
                    <select asp-for="Status" class="edit-dropdown">
                        @foreach (var status in Enum.GetValues(typeof(SmartFleet.Models.VehicleState)))
                        {
                            var statusText = status.ToString();
                            statusText = statusText.Replace("_", " ");
                            statusText = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(statusText.ToLower());
                            
                            if (statusText == "On Scheduled Trip")
                            {
                                statusText = "Scheduled Trip";
                            }
                            
                            <option value="@status" selected="@(status.Equals(Model.Status) ? "selected" : null)">@statusText</option>
                        }
                    </select>
                        <small class="edit-help-text">System Support has full access to change vehicle states.</small>
                    }
                    else
                    {
                        <!-- Read-only for other roles -->
                        <input value="@Model.Status.ToString().Replace("_", " ")" class="edit-input-field" readonly style="background-color: #f8f9fa;" />
                        <small class="edit-help-text">You don't have permission to change vehicle status.</small>
                    }
                    <span asp-validation-for="Status" class="edit-validation-message"></span>
                </div>
            </div>

            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label class="edit-input-label">Current Total Distance (km)</label>
                    <input value="@Model.TotalDistanceTraveled.ToString("F2")" class="edit-input-field" readonly style="background-color: #f8f9fa;" />
                    <span class="edit-readonly-label">readonly</span>
                </div>
                <div class="edit-input-group">
                    <label asp-for="TotalDistanceTraveled" class="edit-input-label">Additional Initial Distance (km)</label>
                    <input asp-for="TotalDistanceTraveled" class="edit-input-field" value="0.00" placeholder="Enter additional distance" step="0.01" />
                    <span asp-validation-for="TotalDistanceTraveled" class="edit-validation-message"></span>
                </div>
            </div>

            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label asp-for="RegistrationExpiryDate" class="edit-input-label">Registration Expiry Date</label>
                    <input asp-for="RegistrationExpiryDate" type="date" class="edit-input-field" />
                    <span asp-validation-for="RegistrationExpiryDate" class="edit-validation-message"></span>
                </div>
                <div class="edit-input-group">
                    <label class="edit-input-label">SimCard Assignment</label>
                    <div class="simcard-assignment-display">
                        @if (Model.SimCard != null)
                        {
                            <div class="current-simcard-info">
                                <span class="simcard-number">@Model.SimCard.SimNumber</span>
                                <span class="simcard-status badge-@Model.SimCard.Status.ToString().ToLower()">
                                    @Model.SimCard.Status.ToString().Replace("_", " ")
                                </span>
                            </div>
                        }
                        else
                        {
                            <span class="no-simcard">No SimCard Assigned</span>
                        }
                    </div>
                    <button type="button" class="edit-simcard-btn" onclick="openSimCardModal()">
                        <i class="fas fa-sim-card"></i> Manage SimCard
                    </button>
                </div>
            </div>


            <div class="edit-input-group">
                <label asp-for="VehicleImageUrl" class="edit-input-label">Vehicle Image</label>
                <input type="file" asp-for="VehicleImageUrl" name="imageFile" class="edit-input-field" accept="image/*" onchange="previewImage(event)" />
                <span asp-validation-for="VehicleImageUrl" class="edit-validation-message"></span>
                <div class="image-preview-container">
                    @if (!string.IsNullOrEmpty(Model.VehicleImageUrl))
                    {
                        <img id="imagePreview" class="image-preview show" src="@Model.VehicleImageUrl" alt="Current vehicle image" />
                        <div id="noImageText" class="no-image-text" style="display: none;">No image selected</div>
                    }
                    else
                    {
                        <img id="imagePreview" class="image-preview" src="" alt="Vehicle image preview" />
                        <div id="noImageText" class="no-image-text">No image selected</div>
                    }
                </div>
            </div>

            <div class="edit-button-group">
                <button type="submit" class="edit-primary-button">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- SimCard Assignment Modal -->
<div id="simCardModal" class="edit-modal" style="display: none;">
    <div class="edit-modal-content">
        <div class="edit-modal-header">
            <h3>Manage SimCard Assignment</h3>
            <span class="edit-modal-close" onclick="closeSimCardModal()">&times;</span>
        </div>
        <div class="edit-modal-body">
            <div class="current-assignment">
                <h4>Current Assignment</h4>
                @if (Model.SimCard != null)
                {
                    <div class="current-simcard-details">
                        <p><strong>Sim Number:</strong> @Model.SimCard.SimNumber</p>
                        <p><strong>Carrier:</strong> @Model.SimCard.Carrier</p>
                        <p><strong>Status:</strong> 
                            <span class="badge-status badge-@Model.SimCard.Status.ToString().ToLower()">
                                @Model.SimCard.Status.ToString().Replace("_", " ")
                            </span>
                        </p>
                    </div>
                    <button type="button" class="edit-modal-btn edit-modal-btn-danger" onclick="removeSimCard()">
                        <i class="fas fa-unlink"></i> Remove SimCard
                    </button>
                }
                else
                {
                    <p class="no-assignment">No SimCard is currently assigned to this vehicle.</p>
                }
            </div>
            
            <div class="assign-new-simcard">
                <h4>Assign New SimCard</h4>
                <form id="assignSimCardForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="vehicleId" value="@Model.Id" />
                    <div class="edit-input-group">
                        <label for="simCardSelect">Select SimCard:</label>
                        <select id="simCardSelect" class="edit-dropdown" required>
                            <option value="">-- Select a SimCard --</option>
                        </select>
                    </div>
                    <div class="edit-modal-actions">
                        <button type="submit" class="edit-modal-btn edit-modal-btn-success">
                            <i class="fas fa-check"></i> Assign SimCard
                        </button>
                        <button type="button" class="edit-modal-btn edit-modal-btn-secondary" onclick="closeSimCardModal()">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Scripts Section -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/vehicle/edit.js"></script>
    
    <script>
        function openSimCardModal() {
            document.getElementById('simCardModal').style.display = 'block';
            loadAvailableSimCards();
        }

        function closeSimCardModal() {
            document.getElementById('simCardModal').style.display = 'none';
        }

        function loadAvailableSimCards() {
            fetch('/api/simcards/available')
                .then(response => response.json())
                .then(data => {
                    const select = document.getElementById('simCardSelect');
                    select.innerHTML = '<option value="">-- Select a SimCard --</option>';
                    
                    data.forEach(simCard => {
                        const option = document.createElement('option');
                        option.value = simCard.id;
                        option.textContent = `${simCard.simNumber} (${simCard.carrier})`;
                        select.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error('Error loading SimCards:', error);
                });
        }

        function removeSimCard() {
            if (confirm('Are you sure you want to remove the SimCard from this vehicle? GPS tracking will stop working.')) {
                fetch('/Vehicles/RemoveSimCard/@Model.Id', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert('Error removing SimCard');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error removing SimCard');
                });
            }
        }

        document.getElementById('assignSimCardForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const vehicleId = document.getElementById('vehicleId').value;
            const simCardId = document.getElementById('simCardSelect').value;
            
            if (!simCardId) {
                alert('Please select a SimCard');
                return;
            }
            
            // Create form data
            const formData = new FormData();
            formData.append('vehicleId', vehicleId);
            formData.append('simCardId', simCardId);
            
            // Get anti-forgery token and add it to form data
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append('__RequestVerificationToken', token);
            
            fetch('/Vehicles/AssignSimCard', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (response.ok) {
                    closeSimCardModal();
                    location.reload();
                } else {
                    return response.text().then(text => {
                        throw new Error(text || 'Error assigning SimCard to vehicle');
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert(error.message || 'Error assigning SimCard to vehicle');
            });
        });

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('simCardModal');
            if (event.target == modal) {
                closeSimCardModal();
            }
        }

        function changeVehicleStatus(newStatus) {
            const statusInput = document.querySelector('input[name="Status"]');
            if (statusInput) {
                statusInput.value = newStatus;
            }
        }
    </script>
}