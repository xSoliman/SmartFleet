@model SmartFleet.Models.Vehicle
@{
    ViewData["Title"] = "Edit Vehicle";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/vehicle/edit.css">
</head>

<div class="edit-layout-container">
    <div class="edit-form-wrapper">
        <!-- Navigation Back Button -->
        <div class="edit-navigation">
            <a asp-action="Index" class="edit-back-link">
                <i class="fas fa-arrow-left"></i> Back to Vehicles
            </a>
        </div>

        <!-- Heading -->
        <h1 class="edit-heading">Edit Vehicle</h1>

        <!-- Form -->
        <form asp-action="Edit" class="edit-custom-form" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="edit-validation-message"></div>
            <input type="hidden" asp-for="Id" />

            <div class="edit-input-group">
                <label asp-for="Model" class="edit-input-label">Vehicle Model</label>
                <input asp-for="Model" class="edit-input-field" placeholder="Enter vehicle model" />
                <span asp-validation-for="Model" class="edit-validation-message"></span>
            </div>

            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label asp-for="Type" class="edit-input-label">Vehicle Type</label>
                    <select asp-for="Type" class="edit-dropdown">
                        <option value="Car">Car</option>
                        <option value="Truck">Truck</option>
                        <option value="Bus">Bus</option>
                        <option value="Van">Van</option>
                        <option value="Motorcycle">Motorcycle</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Type" class="edit-validation-message"></span>
                </div>
                <div class="edit-input-group">
                    <label asp-for="Capacity" class="edit-input-label">Capacity</label>
                    <input asp-for="Capacity" class="edit-input-field" placeholder="Enter capacity" />
                    <span asp-validation-for="Capacity" class="edit-validation-message"></span>
                </div>
            </div>

            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label asp-for="LicensePlate" class="edit-input-label">License Plate</label>
                    <input asp-for="LicensePlate" class="edit-input-field" placeholder="Enter license plate" />
                    <span asp-validation-for="LicensePlate" class="edit-validation-message"></span>
                </div>
                <div class="edit-input-group">
                    <label asp-for="Status" class="edit-input-label">Vehicle Status</label>
                    <select asp-for="Status" class="edit-dropdown">
                        @foreach (var status in Enum.GetValues(typeof(SmartFleet.Models.VehicleState)))
                        {
                            var statusText = status.ToString();
                            // Replace underscores with spaces and capitalize first letter of each word
                            statusText = statusText.Replace("_", " ");
                            statusText = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(statusText.ToLower());
                            
                            // Use shorter text for the long status
                            if (statusText == "On Scheduled Trip")
                            {
                                statusText = "Scheduled Trip";
                            }
                            
                            <option value="@status" selected="@(status.Equals(Model.Status) ? "selected" : null)">@statusText</option>
                        }
                    </select>
                    <span asp-validation-for="Status" class="edit-validation-message"></span>
                </div>
            </div>

            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label class="edit-input-label">Current Total Distance (km)</label>
                    <input value="@Model.TotalDistanceTraveled.ToString("F2")" class="edit-input-field" readonly style="background-color: #f8f9fa;" />
                    <span class="edit-readonly-label">readonly</span>
                </div>
                <div class="edit-input-group">
                    <label asp-for="TotalDistanceTraveled" class="edit-input-label">Additional Initial Distance (km)</label>
                    <input asp-for="TotalDistanceTraveled" class="edit-input-field" value="0.00" placeholder="Enter additional distance" step="0.01" />
                    <span asp-validation-for="TotalDistanceTraveled" class="edit-validation-message"></span>
                </div>
            </div>

            <div class="edit-input-row">
                <div class="edit-input-group">
                    <label asp-for="RegistrationExpiryDate" class="edit-input-label">Registration Expiry Date</label>
                    <input asp-for="RegistrationExpiryDate" type="date" class="edit-input-field" />
                    <span asp-validation-for="RegistrationExpiryDate" class="edit-validation-message"></span>
                </div>
            </div>

            <div class="edit-input-group">
                <label asp-for="VehicleImageUrl" class="edit-input-label">Vehicle Image</label>
                <input type="file" asp-for="VehicleImageUrl" name="imageFile" class="edit-input-field" accept="image/*" onchange="previewImage(event)" />
                <span asp-validation-for="VehicleImageUrl" class="edit-validation-message"></span>
                <div class="image-preview-container">
                    @if (!string.IsNullOrEmpty(Model.VehicleImageUrl))
                    {
                        <img id="imagePreview" class="image-preview show" src="@Model.VehicleImageUrl" alt="Current vehicle image" />
                        <div id="noImageText" class="no-image-text" style="display: none;">No image selected</div>
                    }
                    else
                    {
                        <img id="imagePreview" class="image-preview" src="" alt="Vehicle image preview" />
                        <div id="noImageText" class="no-image-text">No image selected</div>
                    }
                </div>
            </div>

            <div class="edit-button-group">
                <button type="submit" class="edit-primary-button">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Scripts Section -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/vehicle/edit.js"></script>
}