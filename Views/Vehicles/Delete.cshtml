@model SmartFleet.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/vehicle/delete.css">
</head>

<div class="container delete-container">
    <h1><i class="fas fa-exclamation-triangle"></i> Delete Vehicle</h1>
    
    <h3>Are you sure you want to delete this vehicle?</h3>
    
    <div class="vehicle-info">
        <dl class="row">
            <dt class="col-sm-2">Model</dt>
            <dd class="col-sm-10">@Model.Model</dd>
            
            <dt class="col-sm-2">Type</dt>
            <dd class="col-sm-10">@Model.Type</dd>
            
            <dt class="col-sm-2">License Plate</dt>
            <dd class="col-sm-10">@Model.LicensePlate</dd>
            
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">
                @{
                    var statusText = Model.Status.ToString();
                    statusText = statusText.Replace("_", " ");
                    statusText = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(statusText.ToLower());
                    
                    if (statusText == "On Scheduled Trip")
                    {
                        statusText = "Scheduled Trip";
                    }
                }
                <span class="badge-status badge-@Model.Status.ToString().ToLower()">
                    @statusText
                </span>
            </dd>
        </dl>
    </div>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <br />
        <input type="submit" value="Delete" class="btn btn-danger" />  
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
