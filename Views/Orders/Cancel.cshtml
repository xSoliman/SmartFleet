@model SmartFleet.Models.Order

@{
    ViewData["Title"] = "Cancel Order";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h4><i class="fas fa-exclamation-triangle"></i> Cancel Order Confirmation</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Warning:</strong> Are you sure you want to cancel this order? This action cannot be undone.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5>Order Details</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Vehicle Type:</dt>
                                <dd class="col-sm-8">@Model.VehicleType</dd>

                                <dt class="col-sm-4">Passengers:</dt>
                                <dd class="col-sm-8">@Model.PassengerCount</dd>

                                <dt class="col-sm-4">Start Location:</dt>
                                <dd class="col-sm-8">@Model.TripStartLocation</dd>

                                <dt class="col-sm-4">End Location:</dt>
                                <dd class="col-sm-8">@Model.TripEndLocation</dd>

                                <dt class="col-sm-4">Start Date:</dt>
                                <dd class="col-sm-8">@Model.TripStartDate.ToShortDateString()</dd>

                                <dt class="col-sm-4">End Date:</dt>
                                <dd class="col-sm-8">@Model.TripEndDate.ToShortDateString()</dd>

                                <dt class="col-sm-4">Reason:</dt>
                                <dd class="col-sm-8">@Model.Reason</dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge-status badge-@Model.Status.ToString().ToLower()">
                                        @Model.Status
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Created:</dt>
                                <dd class="col-sm-8">@Model.CreatedAt.ToShortDateString()</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="mt-4">
                        <form asp-action="Cancel" method="post">
                            <input type="hidden" asp-for="Id" />
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-times"></i> Confirm Cancel
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Back to Orders
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 