@model SmartFleet.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/order/details.css" />
</head>

<div class="details-layout-container">
    <div class="details-form-wrapper">

        <!-- Back Navigation -->
        <div class="details-navigation">
            <a asp-action="Index" class="details-back-link">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>

        <!-- Heading -->
        <h1 class="details-heading">Order Details</h1>

        <!-- Display Fields in two columns -->
        <div class="details-grid">
            <div class="details-display-group">
                <label class="details-display-label">User ID</label>
                <div class="details-display-value">@Model.User?.Id</div>
            </div>

            <div class="details-display-group">
                <label class="details-display-label">Vehicle Type</label>
                <div class="details-display-value">@Model.VehicleType</div>
            </div>

            <div class="details-display-group">
                <label class="details-display-label">Passenger Count</label>
                <div class="details-display-value">@Model.PassengerCount</div>
            </div>

            <div class="details-display-group">
                <label class="details-display-label">Trip Start Location</label>
                <div class="details-display-value">@Model.StartLocation</div>
            </div>

            <div class="details-display-group">
                <label class="details-display-label">Trip End Location</label>
                <div class="details-display-value">@Model.Destination</div>
            </div>

            <div class="details-display-group">
                <label class="details-display-label">Trip Start Date</label>
                <div class="details-display-value">@Model.TripStartDate.ToShortDateString()</div>
            </div>

            <div class="details-display-group">
                <label class="details-display-label">Trip End Date</label>
                <div class="details-display-value">@Model.TripEndDate.ToShortDateString()</div>
            </div>

            <div class="details-display-group">
                <label class="details-display-label">Reason</label>
                <div class="details-display-value">@Model.Reason</div>
            </div>

            <div class="details-display-group">
                <label class="details-display-label">Status</label>
                <div class="details-display-value">@Model.Status</div>
            </div>

            <div class="details-display-group">
                <label class="details-display-label">Created At</label>
                <div class="details-display-value">@Model.CreatedAt.ToString("g")</div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="details-button-group">
            @if (ViewBag.IsCommissioner)
            {
                <!-- Commissioner can only approve/reject pending orders -->
                @if (Model.Status == SmartFleet.Models.OrderState.Pending)
                {
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" style="display: inline;">
                        <button type="submit" class="details-primary-button btn-success" 
                                onclick="return confirm('Are you sure you want to approve this order?')">
                            <i class="fas fa-check"></i> Approve Order
                        </button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post" style="display: inline;">
                        <button type="submit" class="details-primary-button btn-danger" 
                                onclick="return confirm('Are you sure you want to reject this order?')">
                            <i class="fas fa-times"></i> Reject Order
                        </button>
                    </form>
                }
            }
            else if (ViewBag.IsFleetManager)
            {
                <!-- FleetManager can only create trips for approved orders -->
                @if (Model.Status == SmartFleet.Models.OrderState.Approved)
                {
                    @if (Model.Trip != null)
                    {
                        <!-- Trip already exists -->
                        <span class="details-primary-button btn-secondary disabled">
                            <i class="fas fa-check-circle"></i> Trip Created
                        </span>
                    }
                    else
                    {
                        <!-- No trip exists, can create one -->
                        <a asp-controller="Trips" asp-action="Create" asp-route-id="@Model.Id" asp-route-userId="@Model.UserId" class="details-primary-button btn-success">
                            <i class="fas fa-route"></i> Create Trip
                        </a>
                    }
                }
            }
            else
            {
                <!-- Other roles can edit orders -->
                <a asp-action="Edit" asp-route-id="@Model.Id" class="details-primary-button">Edit</a>
            }
        </div>

    </div>
</div>
