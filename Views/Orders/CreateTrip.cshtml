@model SmartFleet.Models.Trip
@{
    ViewData["Title"] = "Create Trip";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Create Trip for Order</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h5>Order Details</h5>
                            <p><strong>Start Location:</strong> @ViewBag.OrderStartLocation</p>
                            <p><strong>Destination:</strong> @ViewBag.OrderEndLocation</p>
                            <p><strong>Trip Start Date:</strong> @ViewBag.TripStartTime?.ToString("yyyy-MM-dd HH:mm")</p>
                            <p><strong>Trip End Date:</strong> @ViewBag.TripEndTime?.ToString("yyyy-MM-dd HH:mm")</p>
                            <p><strong>Order Created By:</strong> @ViewBag.CreatedByUserName</p>
                        </div>
                    </div>

                    <form asp-action="Create" asp-controller="Trips" method="post">
                        <input type="hidden" name="OrderId" value="@ViewBag.OrderId" />
                        <input type="hidden" name="CreatedBy" value="@ViewBag.CreatedBy" />
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="VehicleId" class="form-label">Vehicle</label>
                                    <select name="VehicleId" id="VehicleId" class="form-select" required>
                                        <option value="">Select a vehicle</option>
                                        @foreach (var item in ViewBag.VehicleId)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="DriverId" class="form-label">Driver</label>
                                    <select name="DriverId" id="DriverId" class="form-select" required>
                                        <option value="">Select a driver</option>
                                        @foreach (var item in ViewBag.DriverId)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">Create Trip</button>
                            <a asp-action="Index" class="btn btn-secondary">Back to Orders</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Add any client-side validation or functionality here
        });
    </script>
} 