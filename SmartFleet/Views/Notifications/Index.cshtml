@model IEnumerable<SmartFleet.Models.Notification>

@{
    ViewData["Title"] = "My Notifications";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/notifications.css" />
    <link rel="stylesheet" href="~/css/components/notification.css" />
}

@functions {
    private string GetNotificationType(string title)
    {
        if (string.IsNullOrEmpty(title))
            return "info";

        title = title.ToLower();

        // Geofence breach - red
        if (title.Contains("geofence breach") || title.Contains("unauthorized vehicle use"))
            return "danger";

        // Completed or accepted - green
        if (title.Contains("completed") || title.Contains("approved") || title.Contains("started"))
            return "success";

        // Rejected - red/orange
        if (title.Contains("rejected") || title.Contains("cancelled") || title.Contains("failed"))
            return "warning";

        // Default - informative
        return "info";
    }
}

<div class="notifications-container">
    <div class="notifications-header">
        <div class="header-content">
            <div class="header-title">
                <i class="fas fa-bell"></i>
                <div class="title-section">
                    <h1>My Notifications</h1>
                    <div class="notification-count" id="pageNotificationCount">Total Notifications: @Model.Count()</div>
                </div>
            </div>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-primary" id="pageMarkAllAsReadBtn" onclick="markAllAsReadFromPage()">
                <i class="fas fa-check-double"></i>
                Mark All as Read
            </button>
        </div>
    </div>

    <div class="notifications-content">
        <div class="notifications-list" id="pageNotificationsList">
            @if (Model.Any())
            {
                @foreach (var notification in Model)
                {
                    var notificationType = GetNotificationType(notification.Title);
                    <div class="notification-item @(!notification.IsRead ? "unread" : "") type-@notificationType" data-notification-id="@notification.Id">
                        <div class="notification-icon">
                            <i class="fas fa-bell"></i>
                        </div>
                        
                        <div class="notification-body">
                            <div class="notification-header">
                                @if (!notification.IsRead)
                                {
                                    <span class="unread-badge type-@notificationType">New</span>
                                }
                                <h3 class="notification-title @(!notification.IsRead ? "fw-bold" : "")">@notification.Title</h3>
                            </div>
                            
                            <p class="notification-message">@notification.Message</p>
                            
                            <div class="notification-meta">
                                <span class="notification-time">
                                    <i class="fas fa-clock"></i>
                                    @notification.CreatedAt.ToLocalTime().ToString("g")
                                </span>
                                @if (notification.RelatedTable != SmartFleet.Models.RelatedTable.None)
                                {
                                    <span class="notification-related">
                                        <i class="fas fa-link"></i>
                                        @notification.RelatedTable
                                    </span>
                                }
                            </div>
                        </div>
                        
                        <div class="notification-actions">
                            @if (!notification.IsRead)
                            {
                                <button type="button" class="action-btn mark-read" 
                                        onclick="markAsReadFromPage(@notification.Id)" title="Mark as Read">
                                    <i class="fas fa-check"></i>
                                </button>
                            }
                            <button type="button" class="action-btn delete" 
                                    onclick="deleteNotificationFromPage(@notification.Id)" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state" id="pageEmptyState">
                    <div class="empty-icon">
                        <i class="fas fa-bell-slash"></i>
                    </div>
                    <h2>No notifications yet</h2>
                    <p>You'll see notifications here when they arrive from the system.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/notification.js"></script>
    <script>
        // Helper function to determine notification type (same as server-side)
        function getNotificationType(title) {
            if (!title) return 'info';
            
            title = title.toLowerCase();
            
            // Geofence breach - red
            if (title.includes('geofence breach') || title.includes('unauthorized vehicle use'))
                return 'danger';
            
            // Completed or accepted - green
            if (title.includes('completed') || title.includes('approved') || title.includes('started'))
                return 'success';
            
            // Rejected - red/orange
            if (title.includes('rejected') || title.includes('cancelled') || title.includes('failed'))
                return 'warning';
            
            // Default - informative
            return 'info';
        }

        // Page-specific notification functions that work with the existing real-time system
        
        // Track notifications being updated to prevent duplicates
        let updatingNotifications = new Set();
        
        // Override the global markAsRead function for this page
        async function markAsReadFromPage(notificationId) {
            try {
                console.log('Marking as read from page:', notificationId);
                
                const response = await fetch('/Notifications/MarkAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify({ id: notificationId })
                });
                
                if (response.ok) {
                    console.log('Mark as read successful, refreshing page...');
                    
                    // Force a page refresh to ensure updates are visible
                    location.reload();
                    
                } else {
                    console.log('Mark as read failed:', response.status);
                    showPageAlert('Error marking notification as read', 'danger');
                }
            } catch (error) {
                console.error('Error marking notification as read:', error);
                showPageAlert('Error marking notification as read', 'danger');
            }
        }
        
        // Override the global markAllAsRead function for this page
        async function markAllAsReadFromPage() {
            try {
                const response = await fetch('/Notifications/MarkAllAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });
                
                if (response.ok) {
                    console.log('Mark all as read successful, refreshing page...');
                    
                    // Force a page refresh to ensure updates are visible
                    location.reload();
                    
                } else {
                    showPageAlert('Error marking all notifications as read', 'danger');
                }
            } catch (error) {
                console.error('Error marking all notifications as read:', error);
                showPageAlert('Error marking all notifications as read', 'danger');
            }
        }
        
        // Delete notification function for this page
        async function deleteNotificationFromPage(notificationId) {
            if (confirm('Are you sure you want to delete this notification?')) {
                try {
                    console.log('Deleting notification from page:', notificationId);
                    
                    const response = await fetch(`/Notifications/Delete/${notificationId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        }
                    });
                    
                    if (response.ok) {
                        console.log('Delete successful, refreshing page...');
                        
                        // Force a page refresh to ensure updates are visible
                        location.reload();
                        
                    } else {
                        console.log('Delete failed:', response.status);
                        showPageAlert('Error deleting notification', 'danger');
                    }
                } catch (error) {
                    console.error('Error deleting notification:', error);
                    showPageAlert('Error deleting notification', 'danger');
                }
            }
        }
        
        // Function to update page notification count (total notifications)
        function updatePageNotificationCount(increment = 0) {
            const pageCount = document.getElementById('pageNotificationCount');
            if (pageCount) {
                const currentText = pageCount.textContent || 'Total Notifications: 0';
                const currentCount = parseInt(currentText.match(/\d+/)?.[0] || '0');
                const newCount = Math.max(0, currentCount + increment);
                pageCount.textContent = `Total Notifications: ${newCount}`;
                
                // Show/hide mark all as read button based on unread count (not total count)
                const unreadCount = document.querySelectorAll('.notification-item.unread').length;
                const markAllBtn = document.getElementById('pageMarkAllAsReadBtn');
                if (markAllBtn) {
                    if (unreadCount > 0) {
                        markAllBtn.style.display = 'inline-block';
                    } else {
                        markAllBtn.style.display = 'none';
                    }
                }
            }
        }
        
        // Function to show empty state
        function showEmptyState() {
            const notificationsList = document.getElementById('pageNotificationsList');
            const emptyState = document.getElementById('pageEmptyState');
            
            if (notificationsList && !emptyState) {
                const newEmptyState = document.createElement('div');
                newEmptyState.className = 'empty-state';
                newEmptyState.id = 'pageEmptyState';
                newEmptyState.innerHTML = `
                    <div class="empty-icon">
                        <i class="fas fa-bell-slash"></i>
                    </div>
                    <h2>No notifications yet</h2>
                    <p>You'll see notifications here when they arrive from the system.</p>
                `;
                notificationsList.appendChild(newEmptyState);
            }
        }
        
        // Function to show page alerts
        function showPageAlert(message, type) {
            const alert = document.createElement('div');
            alert.className = `alert alert-${type} alert-dismissible fade show`;
            alert.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            const container = document.querySelector('.notifications-container');
            container.insertBefore(alert, container.firstChild);
            
            // Remove alert after 3 seconds
            setTimeout(() => {
                if (alert.parentElement) {
                    alert.remove();
                }
            }, 3000);
        }
        
        // Override the existing SignalR handlers to also update this page
        document.addEventListener('DOMContentLoaded', function() {
            // Override the existing ReceiveNotification handler to also update this page
            connection.off("ReceiveNotification");
            connection.on("ReceiveNotification", (notification) => {
                // Call the original handler (for bell functionality)
                console.log('Received notification:', notification);
                
                // Update notification count (bell - unread count)
                updateNotificationCount(1);
                
                // Add new notification to the list (bell dropdown)
                addNotificationToList(notification);
                
                // Show notification toast
                showNotificationToast(notification);
                
                // Also update this page
                addNotificationToPage(notification);
                updatePageNotificationCount(1); // Total count
                
                // Hide empty state if it exists
                const emptyState = document.getElementById('pageEmptyState');
                if (emptyState) {
                    emptyState.remove();
                }
            });
            
            // Override the existing NotificationMarkedAsRead handler
            connection.off("NotificationMarkedAsRead");
            connection.on("NotificationMarkedAsRead", (data) => {
                // Skip if this notification is being updated from this page
                if (updatingNotifications.has(data.id)) {
                    return;
                }
                
                console.log('Notification marked as read:', data);
                
                // Update the notification item in both dropdown and main list
                const notificationItems = document.querySelectorAll(`[data-notification-id="${data.id}"]`);
                let wasUnread = false;
                
                notificationItems.forEach(notificationItem => {
                    if (notificationItem && notificationItem.classList.contains('unread')) {
                        wasUnread = true;
                        notificationItem.classList.remove('unread');
                        const badge = notificationItem.querySelector('.badge');
                        if (badge) badge.remove();
                        const title = notificationItem.querySelector('h6');
                        if (title) title.classList.remove('fw-bold');
                        
                        // Remove the "New" badge if it exists
                        const newBadge = notificationItem.querySelector('.notification-new-badge');
                        if (newBadge) newBadge.remove();
                        
                        // Remove the unread-badge if it exists
                        const unreadBadge = notificationItem.querySelector('.unread-badge');
                        if (unreadBadge) unreadBadge.remove();
                        
                        // Remove the mark-read button if it exists
                        const markReadBtn = notificationItem.querySelector('.action-btn.mark-read');
                        if (markReadBtn) markReadBtn.remove();
                    }
                });
                
                // Update bell count only if the notification was actually unread
                if (wasUnread) {
                    updateNotificationCount(-1);
                }
                
                // Note: We don't update pageNotificationCount here because it should show total count
            });
            
            // Override the existing AllNotificationsMarkedAsRead handler
            connection.off("AllNotificationsMarkedAsRead");
            connection.on("AllNotificationsMarkedAsRead", () => {
                console.log('All notifications marked as read');
                
                // Count unread notifications before updating
                const unreadItems = document.querySelectorAll('.notification-item.unread');
                const unreadCount = unreadItems.length;
                
                // Update all notification items
                unreadItems.forEach(item => {
                    item.classList.remove('unread');
                    const badge = item.querySelector('.badge');
                    if (badge) badge.remove();
                    const title = item.querySelector('h6');
                    if (title) title.classList.remove('fw-bold');
                    
                    // Remove the "New" badge if it exists
                    const newBadge = item.querySelector('.notification-new-badge');
                    if (newBadge) newBadge.remove();
                    
                    // Remove the unread-badge if it exists
                    const unreadBadge = item.querySelector('.unread-badge');
                    if (unreadBadge) unreadBadge.remove();
                    
                    // Remove the mark-read button if it exists
                    const markReadBtn = item.querySelector('.action-btn.mark-read');
                    if (markReadBtn) markReadBtn.remove();
                });
                
                // Update notification count using the proper function
                if (unreadCount > 0) {
                    updateNotificationCount(-unreadCount);
                }
                
                // Hide the mark all as read button on this page
                const markAllBtn = document.getElementById('pageMarkAllAsReadBtn');
                if (markAllBtn) {
                    markAllBtn.style.display = 'none';
                }
                
                // Note: We don't update pageNotificationCount here because it should show total count
            });
            
            // Add new handler for notification deletion (real-time deletion)
            connection.on("NotificationDeleted", (data) => {
                // Skip if this notification is being updated from this page
                if (updatingNotifications.has(data.id)) {
                    return;
                }
                
                console.log('Notification deleted:', data);
                
                // Remove the notification item from this page
                const notificationItem = document.querySelector(`[data-notification-id="${data.id}"]`);
                if (notificationItem) {
                    // Check if it was unread to update bell count
                    const wasUnread = notificationItem.classList.contains('unread');
                    
                    notificationItem.remove();
                    
                    // Update page notification count (total count)
                    updatePageNotificationCount(-1);
                    
                    // Update bell count only if it was unread
                    if (wasUnread) {
                        updateNotificationCount(-1);
                    }
                    
                    // Check if this was the last notification
                    const remainingNotifications = document.querySelectorAll('.notification-item');
                    if (remainingNotifications.length === 0) {
                        showEmptyState();
                    }
                }
            });
        });
        
        // Function to add notification to this page
        function addNotificationToPage(notification) {
            const notificationsList = document.getElementById('pageNotificationsList');
            if (notificationsList) {
                const notificationType = getNotificationType(notification.title);
                const notificationItem = document.createElement('div');
                notificationItem.className = `notification-item unread type-${notificationType}`;
                notificationItem.setAttribute('data-notification-id', notification.id);
                
                const createdAt = new Date(notification.createdAt).toLocaleString();
                
                notificationItem.innerHTML = `
                    <div class="notification-icon">
                        <i class="fas fa-bell"></i>
                    </div>
                    
                    <div class="notification-body">
                        <div class="notification-header">
                            <span class="unread-badge type-${notificationType}">New</span>
                            <h3 class="notification-title fw-bold">${notification.title}</h3>
                        </div>
                        
                        <p class="notification-message">${notification.message}</p>
                        
                        <div class="notification-meta">
                            <span class="notification-time">
                                <i class="fas fa-clock"></i>
                                ${createdAt}
                            </span>
                        </div>
                    </div>
                    
                    <div class="notification-actions">
                        <button type="button" class="action-btn mark-read" 
                                onclick="markAsReadFromPage(${notification.id})" title="Mark as Read">
                            <i class="fas fa-check"></i>
                        </button>
                        <button type="button" class="action-btn delete" 
                                onclick="deleteNotificationFromPage(${notification.id})" title="Delete">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                `;
                
                // Insert at the top of the list
                if (notificationsList.firstChild) {
                    notificationsList.insertBefore(notificationItem, notificationsList.firstChild);
                } else {
                    notificationsList.appendChild(notificationItem);
                }
                
                // Remove empty state if it exists
                const emptyState = document.getElementById('pageEmptyState');
                if (emptyState) {
                    emptyState.remove();
                }
            }
        }
        
        // Initialize page notification count on load
        document.addEventListener('DOMContentLoaded', function() {
            const totalCount = document.querySelectorAll('.notification-item').length;
            const unreadCount = document.querySelectorAll('.notification-item.unread').length;
            
            // Set the page count to total notifications in new format
            const pageCount = document.getElementById('pageNotificationCount');
            if (pageCount) {
                pageCount.textContent = `Total Notifications: ${totalCount}`;
            }
            
            // Show/hide mark all as read button based on unread count
            const markAllBtn = document.getElementById('pageMarkAllAsReadBtn');
            if (markAllBtn) {
                if (unreadCount > 0) {
                    markAllBtn.style.display = 'inline-block';
                } else {
                    markAllBtn.style.display = 'none';
                }
            }
        });
    </script>
}
