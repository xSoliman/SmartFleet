@model SmartFleet.Models.Trip

@{
    ViewData["Title"] = "Trip Details";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/trip/details.css" />
</head>

<div class="details-container">
    <div class="details-card">
        <div class="details-header">
            <a asp-action="Index" class="details-back-link">
                <i class="fas fa-arrow-left"></i> Back to Trips
            </a>
            <h1>Trip Details</h1>
            <div class="details-status-badge status-@Model.Status.ToString().ToLower()">
                @Model.Status
            </div>
        </div>

        <div class="details-body">
            <div class="details-section">
                <h5 class="details-section-title">Assignment Details</h5>
                <div class="details-grid">
                    <div class="details-item">
                        <label>Vehicle</label>
                        <div>@Model.Vehicle?.Model (@Model.Vehicle?.LicensePlate)</div>
                    </div>
                    <div class="details-item">
                        <label>Driver</label>
                        <div>@Model.Driver?.UserName</div>
                    </div>
                    <div class="details-item">
                        <label>Created By</label>
                        <div>@Model.CreatedByUser?.UserName</div>
                    </div>
                    <div class="details-item">
                        <label>Created At</label>
                        <div>@Model.CreatedAt.ToString("g")</div>
                    </div>
                </div>
            </div>

            <div class="details-section">
                <h5 class="details-section-title">Route & Schedule</h5>
                <div class="details-grid">
                    <div class="details-item">
                        <label>Start Location</label>
                        <div>@Model.Order?.StartLocation</div>
                    </div>
                    <div class="details-item">
                        <label>Destination</label>
                        <div>@Model.Order?.Destination</div>
                    </div>
                    <div class="details-item">
                        <label>Scheduled Start</label>
                        <div>@Model.Order?.TripStartDate.ToString("g")</div>
                    </div>
                    <div class="details-item">
                        <label>Scheduled End</label>
                        <div>@Model.Order?.TripEndDate.ToString("g")</div>
                    </div>
                </div>
            </div>
            
            <div class="details-section">
                <h5 class="details-section-title">Tracking Information</h5>
                <div class="details-grid">
                    <div class="details-item">
                        <label>Distance Traveled</label>
                        <div>@Model.Distance.ToString("N2") km</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="details-footer">
            @if (Model.Status != TripState.Completed && Model.Status != TripState.Cancelled)
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Edit Trip
                </a>
            }
            @if (Model.Status == TripState.Scheduled || Model.Status == TripState.InProgress)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to cancel this trip?')">
                        <i class="fas fa-times"></i> Cancel Trip
                    </button>
                </form>
            }
        </div>
    </div>
</div>
