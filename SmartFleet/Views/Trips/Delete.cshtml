@model SmartFleet.Models.Trip

@{
    ViewData["Title"] = "Delete Trip";
}

<h1>Delete Trip</h1>

<h3>Are you sure you want to delete this trip?</h3>
<div>
    <h4>Trip Information</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Vehicle
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Vehicle.Model) (@Html.DisplayFor(model => model.Vehicle.Type))
        </dd>
        <dt class = "col-sm-2">
            Order ID
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Order.Id)
        </dd>
        <dt class = "col-sm-2">
            Driver
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Driver.UserName)
        </dd>
        <dt class = "col-sm-2">
            Trip Start Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Order.TripStartDate)
        </dd>
        <dt class = "col-sm-2">
            Trip End Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Order.TripEndDate)
        </dd>
        <dt class = "col-sm-2">
            Distance
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Distance) km
        </dd>
        <dt class = "col-sm-2">
            Status
        </dt>
        <dd class = "col-sm-10">
            <span class="badge badge-@Model.Status.ToString().ToLower()">
                @Html.DisplayFor(model => model.Status)
            </span>
        </dd>
        <dt class = "col-sm-2">
            Created At
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
        <dt class = "col-sm-2">
            Created By
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedByUser.UserName)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
