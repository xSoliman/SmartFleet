@model SmartFleet.ViewModel.EditProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}   

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/account/EditProfile.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<div class="edit-layout-container">
    <div class="edit-form-wrapper">
        <div class="edit-navigation">
            <a asp-action="MyAccount" class="edit-back-link">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>

        <h1 class="edit-heading">Edit Profile</h1>

        <div asp-validation-summary="All" class="edit-validation-summary" style="display: none;"></div>

        <form asp-action="EditProfile" method="post" class="edit-custom-form" enctype="multipart/form-data">
            <div class="profile-container">
                <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : Model.ImageUrl)" 
                     class="img-fluid rounded-circle" 
                     alt="No profile picture" 
                     onerror="this.onerror=null; this.src=''; this.alt='No profile picture';">
                <label class="camera-icon" for="fileUpload" title="Change profile picture">
                    <i class="fas fa-camera"></i>
                </label>
                <input type="file" id="fileUpload" name="ImageFile" class="d-none" accept="image/*" onchange="previewImage(event)">
            </div>

            <div class="edit-input-group">
                <label asp-for="UserName" class="edit-input-label">Username</label>
                <input asp-for="UserName" class="edit-input-field" placeholder="Enter your username" />
                <span asp-validation-for="UserName" class="edit-validation-message"></span>
            </div>

            <div class="edit-input-group">
                <label asp-for="Email" class="edit-input-label">Email Address</label>
                <input asp-for="Email" class="edit-input-field" placeholder="Your email address" />
                <span asp-validation-for="Email" class="edit-validation-message"></span>
            </div>

            <div class="edit-input-group">
                <label asp-for="PhoneNumber" class="edit-input-label">Phone Number</label>
                <input asp-for="PhoneNumber" class="edit-input-field" placeholder="Enter your phone number" />
                <span asp-validation-for="PhoneNumber" class="edit-validation-message"></span>
            </div>

            @if (Model.IsDriver)
            {
                <div class="driver-license-section">
                    <h3 class="driver-section-title">Driver License Information</h3>
                    
                    <div class="edit-input-group">
                        <label asp-for="LicenseNumber" class="edit-input-label">License Number</label>
                        <input asp-for="LicenseNumber" class="edit-input-field" placeholder="Enter your license number" />
                        <span asp-validation-for="LicenseNumber" class="edit-validation-message"></span>
                    </div>

                    <div class="edit-input-group">
                        <label asp-for="LicenseExpiryDate" class="edit-input-label">License Expiry Date</label>
                        <input asp-for="LicenseExpiryDate" type="date" class="edit-input-field" />
                        <span asp-validation-for="LicenseExpiryDate" class="edit-validation-message"></span>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="edit-input-group">
                    <label class="edit-input-label">
                        <input asp-for="RemoveImage" type="checkbox" /> Remove current profile picture
                    </label>
                </div>
            }

            <div class="edit-button-group">
                <button type="submit" class="edit-primary-button" style="text-align: center !important; color: white !important;">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account/EditProfile.js"></script>
}

