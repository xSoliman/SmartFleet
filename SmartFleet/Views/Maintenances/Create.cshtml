@model SmartFleet.Models.Maintenance

@{
    ViewData["Title"] = "Create Maintenance";
    
    // Ensure ViewBag data is available
    if (ViewBag.VehicleInfo == null)
    {
        ViewBag.VehicleInfo = null;
    }
    if (ViewBag.UserInfo == null)
    {
        ViewBag.UserInfo = null;
    }
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/maintenance/form.css">
</head>

<div class="maintenance-layout-container">
    <div class="maintenance-form-wrapper">
        <div class="maintenance-navigation">
            <a asp-action="Index" class="maintenance-back-link">
                <i class="fas fa-arrow-left"></i> Back to Maintenance
            </a>
        </div>
        <h1 class="maintenance-heading">Create Maintenance</h1>
        
        <!-- Information Section -->
        <div class="maintenance-info-section">
            <h3 class="maintenance-info-title">
                <i class="fas fa-info-circle"></i>
                Maintenance Information
            </h3>
            <div class="maintenance-info-grid">
                <div class="maintenance-info-item">
                    <label class="maintenance-info-label">Vehicle</label>
                    @if (Model.VehicleId > 0)
                    {
                        var vehicle = ViewBag.VehicleInfo as SmartFleet.Models.Vehicle;
                        if (vehicle != null)
                        {
                            <div class="maintenance-info-value">
                                <i class="fas fa-car"></i>
                                @vehicle.LicensePlate - @vehicle.Model
                            </div>
                        }
                        else
                        {
                            <div class="maintenance-info-value">
                                <i class="fas fa-exclamation-triangle"></i>
                                Vehicle ID: @Model.VehicleId (Vehicle not found)
                            </div>
                        }
                    }
                    else
                    {
                        <div class="maintenance-info-value">
                            <i class="fas fa-question-circle"></i>
                            No vehicle selected
                        </div>
                    }
                </div>
                
                <div class="maintenance-info-item">
                    <label class="maintenance-info-label">Reported By</label>
                    @if (!string.IsNullOrEmpty(Model.ReportedBy))
                    {
                        var user = ViewBag.UserInfo as SmartFleet.Models.ApplicationUser;
                        if (user != null)
                        {
                            <div class="maintenance-info-value">
                                <i class="fas fa-user"></i>
                                @user.UserName (@user.Email)
                            </div>
                        }
                        else
                        {
                            <div class="maintenance-info-value">
                                <i class="fas fa-exclamation-triangle"></i>
                                User ID: @Model.ReportedBy (User not found)
                            </div>
                        }
                    }
                    else
                    {
                        <div class="maintenance-info-value">
                            <i class="fas fa-question-circle"></i>
                            No user selected
                        </div>
                    }
                </div>
            </div>
        </div>

        <form asp-action="Create" method="post" class="maintenance-custom-form">
            <div asp-validation-summary="All" class="maintenance-validation-message"></div>

            <!-- Hidden fields for vehicle and reporter -->
            <input type="hidden" asp-for="VehicleId" />
            <input type="hidden" asp-for="ReportedBy" />

            <!-- Enhanced Issue Description Field -->
            <div class="maintenance-input-group enhanced">
                <label asp-for="IssueDescription" class="maintenance-input-label enhanced">
                    <i class="fas fa-clipboard-list"></i>
                    Issue Description
                </label>
                <textarea asp-for="IssueDescription" class="maintenance-input-field enhanced" rows="4" 
                          placeholder="Describe the maintenance issue in detail..."></textarea>
                <span asp-validation-for="IssueDescription" class="maintenance-validation-message"></span>
            </div>

            <!-- Enhanced Status and Priority Fields -->
            <div class="maintenance-input-row enhanced">
                <div class="maintenance-input-group enhanced">
                    <label asp-for="RepairStatus" class="maintenance-input-label enhanced">
                        <i class="fas fa-tools"></i>
                        Repair Status
                    </label>
                    <select asp-for="RepairStatus" class="maintenance-dropdown enhanced">
                        <option value="">-- Select Status --</option>
                        <option value="pending">Pending</option>
                        <option value="in_progress">In Progress</option>
                    </select>
                    <span asp-validation-for="RepairStatus" class="maintenance-validation-message"></span>
                </div>
                
                <div class="maintenance-input-group enhanced">
                    <label asp-for="Priority" class="maintenance-input-label enhanced">
                        <i class="fas fa-exclamation-triangle"></i>
                        Priority Level
                    </label>
                    <select asp-for="Priority" class="maintenance-dropdown enhanced" asp-items="Html.GetEnumSelectList<PriorityDegree>()">
                        <option value="">-- Select Priority --</option>
                    </select>
                    <span asp-validation-for="Priority" class="maintenance-validation-message"></span>
                </div>
            </div>

            <div class="maintenance-button-group">
                <button type="submit" class="maintenance-primary-button">
                    <i class="fas fa-plus"></i> Create Maintenance
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
