@model SmartFleet.ViewModel.UserManagementViewModel

@{
    ViewData["Title"] = "User Management";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/pages/users/users.css" />

<div class="users-management-page">
    <div class="container-fluid">
        <!-- Enhanced Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="header-content">
                <h2 class="mb-1 text-dark">
                    <i class="fas fa-users-cog me-2 text-primary"></i>
                    User Management
                </h2>
                <p class="text-muted mb-0">Manage system users, roles, and permissions</p>
            </div>
            <div class="action-buttons">
                <a asp-action="CreateUser" class="btn btn-primary btn-enhanced">
                    <i class="fas fa-user-plus me-2"></i>Create User
                </a>
                <a asp-action="ManageRoles" class="btn btn-info btn-enhanced">
                    <i class="fas fa-cogs me-2"></i>Manage Roles
                </a>
            </div>
        </div>

        <!-- Enhanced Alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show enhanced-alert">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show enhanced-alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Enhanced Statistics Cards -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card stats-card total-users">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="number">@Model.TotalUsers</div>
                        <p class="label">Total Users</p>
                        <div class="stats-subtitle">System-wide</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card stats-card active-users">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <div class="number">@Model.ActiveUsers</div>
                        <p class="label">Active Users</p>
                        <div class="stats-subtitle">@(Model.TotalUsers > 0 ? $"{Math.Round((double)Model.ActiveUsers / Model.TotalUsers * 100, 1)}%" : "0%") of total</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card stats-card inactive-users">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-user-times"></i>
                        </div>
                        <div class="number">@Model.InactiveUsers</div>
                        <p class="label">Inactive Users</p>
                        <div class="stats-subtitle">@(Model.TotalUsers > 0 ? $"{Math.Round((double)Model.InactiveUsers / Model.TotalUsers * 100, 1)}%" : "0%") of total</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card stats-card drivers">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="fas fa-id-card"></i>
                        </div>
                        <div class="number">@Model.DriversCount</div>
                        <p class="label">Drivers</p>
                        <div class="stats-subtitle">@(Model.TotalUsers > 0 ? $"{Math.Round((double)Model.DriversCount / Model.TotalUsers * 100, 1)}%" : "0%") of total</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search Form -->
        <form asp-action="Index" method="get" class="row g-3 mb-3">
            <div class="col-md-4">
                <input type="text" name="searchUserName" value="@ViewBag.SearchUserName" class="form-control" placeholder="Search by Username" />
            </div>
            <div class="col-md-4">
                <input type="text" name="searchEmail" value="@ViewBag.SearchEmail" class="form-control" placeholder="Search by Email" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-2"></i>Search</button>
            </div>
        </form>

        <!-- Enhanced Users Table -->
        <div class="card main-card">
            <div class="card-header">
                <h5><i class="fas fa-list me-2"></i>Users List</h5>
        
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table users-table mb-0">
                        <thead>
                            <tr>
                                <th><i class="fas fa-user me-1"></i>User</th>
                                <th><i class="fas fa-envelope me-1"></i>Email</th>
                                <th><i class="fas fa-phone me-1"></i>Phone</th>
                                <th><i class="fas fa-id-badge me-1"></i>Roles</th>
                                <th><i class="fas fa-toggle-on me-1"></i>Status</th>
                                <th><i class="fas fa-info-circle me-1"></i>Driver Info</th>
                                <th><i class="fas fa-tools me-1"></i>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr class="user-row @(user.IsActive ? "active-user" : "inactive-user")">
                                    <td>
                                        <div class="user-info">
                                            <div class="user-avatar">
                                                <i class="fas fa-user-circle"></i>
                                            </div>
                                            <div class="user-details">
                                                <div class="fw-bold">@user.UserName</div>
                                                <small class="text-muted">Created @user.CreatedAt.ToString("MMM dd, yyyy")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-break">@user.Email</td>
                                    <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "-" : user.PhoneNumber)</td>
                                    <td>
                                        @if (Model.UserRoles.ContainsKey(user.Id) && Model.UserRoles[user.Id].Any())
                                        {
                                            @foreach (var role in Model.UserRoles[user.Id])
                                            {
                                                var badgeClass = role.ToLower() switch
                                                {
                                                    "syssupport" => "badge-sys-support",
                                                    "fleetmanager" => "badge-fleet-manager",
                                                    "driver" => "badge-driver",
                                                    "maintenancemanager" => "badge-maintenance",
                                                    "commissioner" => "badge-commissioner",
                                                    "normaluser" => "badge-normal",
                                                    _ => "badge-default"
                                                };
                                                <span class="badge @badgeClass">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge badge-default">No Roles</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="status-badge active">
                                                <i class="fas fa-check-circle me-1"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge inactive">
                                                <i class="fas fa-ban me-1"></i>Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.DriverDetails.ContainsKey(user.Id))
                                        {
                                            var driver = Model.DriverDetails[user.Id];
                                            <div class="driver-info">
                                                <div><strong>License:</strong> @driver.LicenseNumber</div>
                                                <div><strong>Expiry:</strong> @driver.LicenseExpiryDate?.ToString("MMM dd, yyyy")</div>
                                                <div><strong>Status:</strong> @driver.DriverStatus</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-buttons-group">
                                            <form asp-action="ToggleAccountStatus" method="post" style="display: inline;">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                @if (user.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-action btn-warning" title="Deactivate User">
                                                        <i class="fas fa-ban"style="color:white"></i>
                                                        <span class="action-text" style="color:white">Deactivate</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-action btn-success" title="Activate User">
                                                        <i class="fas fa-check"style="color:white"></i>
                                                        <span class="action-text" style="color:white">Activate</span>
                                                    </button>
                                                }
                                            </form>
                                            <form asp-action="DeleteUser" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-action btn-danger" title="Delete User">
                                                    <i class="fas fa-trash"style="color:white"></i>
                                                    <span class="action-text"style="color:white">Delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- Pagination Controls -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, searchUserName = ViewBag.SearchUserName, searchEmail = ViewBag.SearchEmail })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<script>
    // Enhanced counter animation with easing
    document.addEventListener('DOMContentLoaded', function() {
        const numbers = document.querySelectorAll('.stats-card .number');
        numbers.forEach(function(number) {
            const target = parseInt(number.textContent);
            let current = 0;
            const duration = 1500; // 1.5 seconds
            const startTime = performance.now();
            
            function animate(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                
                // Easing function for smooth animation
                const easeOutQuart = 1 - Math.pow(1 - progress, 4);
                current = Math.floor(target * easeOutQuart);
                
                number.textContent = current;
                
                if (progress < 1) {
                    requestAnimationFrame(animate);
                }
            }
            
            requestAnimationFrame(animate);
        });
    });
</script> 