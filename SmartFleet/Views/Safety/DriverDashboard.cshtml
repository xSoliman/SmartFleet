@model SmartFleet.Models.Driver

@{
    ViewData["Title"] = "Driver Dashboard";
}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h2 class="mb-4 text-center"><i class="fas fa-user-circle me-2"></i>Driver Dashboard</h2>

        <dl class="row">
            <dt class="col-sm-4">Username:</dt>
            <dd class="col-sm-8">@Model.UserName</dd>

            <dt class="col-sm-4">License Number:</dt>
            <dd class="col-sm-8">@Model.LicenseNumber</dd>

            <dt class="col-sm-4">License Expiry Date:</dt>
            <dd class="col-sm-8">@Model.LicenseExpiryDate.ToShortDateString()</dd>

            <dt class="col-sm-4">Status:</dt>
            <dd class="col-sm-8">@Model.DriverStatus</dd>

            <dt class="col-sm-4 text-danger">Drowsiness Count:</dt>
            <dd class="col-sm-8 text-danger fw-bold">@Model.DrowsinessCount</dd>
        </dl>

        <div class="text-center mt-4">
            <form asp-action="StartMonitoring" method="post">
                <button type="submit" class="btn btn-danger btn-lg">
                    <i class="fas fa-play-circle me-2"></i>Start Monitoring Again
                </button>
            </form>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
