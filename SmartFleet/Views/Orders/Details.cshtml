@model SmartFleet.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/order/details.css" />
</head>

<div class="details-container">
    <div class="details-card">
        <div class="details-header">
            <a asp-action="Index" class="details-back-link">
                <i class="fas fa-arrow-left"></i> Back to Orders
            </a>
            <h1>Order Details</h1>
            <div class="details-status-badge status-@Model.Status.ToString().ToLower()">
                @Model.Status
            </div>
        </div>

        <div class="details-body">
            @if (ViewBag.IsCommissioner == true || ViewBag.IsFleetManager == true)
            {
                <div class="details-section">
                    <h5 class="details-section-title">Resource Availability</h5>
                    <div class="resource-availability">
                        @if (Model.Status == SmartFleet.Models.OrderState.Pending || (Model.Status == SmartFleet.Models.OrderState.Approved && Model.Trip == null))
                        {
                            if (ViewBag.ResourceAvailability == "Available")
                            {
                                <span class="badge available"><i class="fas fa-check-circle"></i> Available</span>
                            }
                            else if (ViewBag.ResourceAvailability == "Not Available")
                            {
                                <span class="badge not-available"><i class="fas fa-times-circle"></i> Not Available</span>
                            }
                            else
                            {
                                <span class="badge unknown">Unknown</span>
                            }
                        }
                        else
                        {
                            <span class="badge not-applicable">N/A</span>
                        }
                    </div>
                </div>
            }

            <div class="details-section">
                <h5 class="details-section-title">User Information</h5>
                <div class="details-grid">
                    <div class="details-item">
                        <label>User Name</label>
                        <div>@Model.User?.UserName</div>
                    </div>
                    <div class="details-item">
                        <label>User Email</label>
                        <div>@Model.User?.Email</div>
                    </div>
                </div>
            </div>

            <div class="details-section">
                <h5 class="details-section-title">Order Specifications</h5>
                <div class="details-grid">
                    <div class="details-item">
                        <label>Vehicle Type</label>
                        <div>@Model.VehicleType</div>
                    </div>
                    <div class="details-item">
                        <label>Passenger Count</label>
                        <div>@Model.PassengerCount</div>
                    </div>
                    <div class="details-item full-width">
                        <label>Reason for Trip</label>
                        <div>@Model.Reason</div>
                    </div>
                </div>
            </div>

            <div class="details-section">
                <h5 class="details-section-title">Trip Details</h5>
                <div class="details-grid">
                    <div class="details-item">
                        <label>Start Location</label>
                        <div>@Model.StartLocation</div>
                    </div>
                    <div class="details-item">
                        <label>Destination</label>
                        <div>@Model.Destination</div>
                    </div>
                    <div class="details-item">
                        <label>Start Date</label>
                        <div>@Model.TripStartDate.ToShortDateString()</div>
                    </div>
                    <div class="details-item">
                        <label>End Date</label>
                        <div>@Model.TripEndDate.ToShortDateString()</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="details-footer">
            @if (ViewBag.IsCommissioner)
            {
                @if (Model.Status == SmartFleet.Models.OrderState.Pending)
                {
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-success" onclick="return confirm('Are you sure you want to approve this order?')">
                            <i class="fas fa-check"></i> Approve
                        </button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to reject this order?')">
                            <i class="fas fa-times"></i> Reject
                        </button>
                    </form>
                }
            }
            else if (ViewBag.IsFleetManager)
            {
                @if (Model.Status == SmartFleet.Models.OrderState.Approved)
                {
                    @if (Model.Trip != null)
                    {
                        <span class="btn btn-secondary disabled"><i class="fas fa-check-circle"></i> Trip Created</span>
                    }
                    else
                    {
                        <a asp-controller="Trips" asp-action="Create" asp-route-id="@Model.Id" asp-route-userId="@Model.UserId" class="btn btn-success">
                            <i class="fas fa-route"></i> Create Trip
                        </a>
                    }
                }
            }
            else
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Edit Order
                </a>
            }
        </div>
    </div>
</div>

