@model SmartFleet.ViewComponents.NotificationListViewModel

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="nav-item me-3">
        <a class="nav-link position-relative notification-bell @(Model.UnreadCount > 0 ? "has-unread" : "no-unread")" href="#" id="notificationDropdown" role="button">
            <i class="fas fa-bell fa-lg"></i>
            <span id="notificationCount" class="badge position-absolute top-0 start-100 translate-middle rounded-pill notification-badge @(Model.UnreadCount > 0 ? "" : "no-unread")" style="display: @(Model.UnreadCount > 0 ? "flex" : "none");">
                @Model.UnreadCount
            </span>
        </a>
        <div class="notification-dropdown" id="notificationDropdownMenu">
            <div class="notification-header-section">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">Notifications</h6>
                    @if (Model.UnreadCount > 0)
                    {
                        <button type="button" id="markAllAsReadButton" class="btn btn-sm btn-outline-primary" onclick="markAllAsRead()">
                            Mark all as read
                        </button>
                    }
                </div>
            </div>
            <div id="notificationList" class="notification-list-container">
                @if (Model.Notifications.Any())
                {
                    @foreach (var notification in Model.Notifications.OrderByDescending(n => n.CreatedAt).Take(10))
                    {
                        <div class="dropdown-item notification-item @(!notification.IsRead ? "unread" : "")" 
                             data-notification-id="@notification.Id" 
                             onclick="markAsRead(@notification.Id)">
                            <div class="notification-content">
                                <div class="notification-header">
                                    <h6 class="notification-title @(!notification.IsRead ? "fw-bold" : "")">@notification.Title</h6>
                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge notification-new-badge">New</span>
                                    }
                                </div>
                                <p class="notification-message">@notification.Message</p>
                                <small class="notification-time">@notification.CreatedAt.ToLocalTime().ToString("g")</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="dropdown-item text-center text-muted py-4">
                        <i class="fas fa-bell-slash fa-2x mb-3 text-muted"></i>
                        <p class="mb-0">No notifications</p>
                    </div>
                }
            </div>
            <div class="notification-footer-section">
                <a class="dropdown-item text-center notification-view-all" asp-controller="Notifications" asp-action="Index">
                    <i class="fas fa-list me-2"></i>View all notifications
                </a>
            </div>
        </div>
    </div>
}