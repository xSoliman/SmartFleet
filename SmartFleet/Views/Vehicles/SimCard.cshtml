@model SmartFleet.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle SimCard";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/vehicle/details.css">
    <link rel="stylesheet" href="~/css/pages/trip/searchable-dropdowns.css">
</head>

<div class="main-container">
    <!-- Left Section: SimCard Information -->
    <div class="left-container">
        <!-- Back Button -->
        <div class="details-navigation">
            <a asp-action="Index" class="details-back-link">
                <i class="fas fa-arrow-left"></i> Back to Vehicles
            </a>
        </div>

        <!-- Vehicle Info Header -->
        <div class="vehicle-container">
            <h1 class="vehicle-heading">SimCard Information - @Model.Model</h1>
            <div class="vehicle-details">
                <div class="vehicle-item">
                    <span class="vehicle-label">License Plate:</span>
                    <span>@Model.LicensePlate</span>
                </div>
                <div class="vehicle-item">
                    <span class="vehicle-label">Status:</span>
                    <span>
                        @{
                            var statusText = Model.Status.ToString();
                            statusText = statusText.Replace("_", " ");
                            statusText = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(statusText.ToLower());
                            
                            if (statusText == "On Scheduled Trip")
                            {
                                statusText = "Scheduled Trip";
                            }
                        }
                        <span class="badge-status badge-@Model.Status.ToString().ToLower()">
                            @statusText
                        </span>
                    </span>
                </div>
            </div>
        </div>

        <!-- SimCard Assignment Section -->
        <div id="simcard-assignment-container">
            <h2><i class="fas fa-link"></i> SimCard Assignment</h2>
            
            @if (Model.SimCard != null)
            {
                <!-- Current SimCard Info -->
                <div class="current-simcard">
                    <h3>Currently Assigned SimCard</h3>
                    <div class="simcard-info">
                        <div class="simcard-item">
                            <span class="simcard-label">Sim Number:</span>
                            <span class="simcard-value">@Model.SimCard.SimNumber</span>
                        </div>
                        <div class="simcard-item">
                            <span class="simcard-label">Carrier:</span>
                            <span class="simcard-value">@Model.SimCard.Carrier</span>
                        </div>
                        <div class="simcard-item">
                            <span class="simcard-label">Status:</span>
                            <span class="simcard-value">
                                <span class="badge-status badge-@Model.SimCard.Status.ToString().ToLower()">
                                    @Model.SimCard.Status.ToString().Replace("_", " ")
                                </span>
                            </span>
                        </div>
                    </div>
                    
                    <!-- Change SimCard Button -->
                    <div class="simcard-action-buttons">
                        <button class="simcard-btn simcard-btn-warning" onclick="showAssignmentForm()">
                            <i class="fas fa-exchange-alt" style="color:white !important;"></i> <span style="color:white !important;">Change SimCard</span>
                        </button>
                        <button class="simcard-btn simcard-btn-danger" onclick="removeSimCard()">
                            <i class="fas fa-unlink" style="color:white !important;"></i> <span style="color:white !important;">Remove SimCard</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- No SimCard Assigned -->
                <div class="no-simcard">
                    <div class="simcard-no-content-message">
                        <i class="fas fa-exclamation-triangle"></i>
                        <h3>No SimCard Assigned</h3>
                        <p>This vehicle doesn't have a SimCard assigned.</p>
                        <p>GPS tracking will not work until a SimCard is assigned.</p>
                    </div>
                </div>
            }
            <!-- Assignment Form: Always present, only hidden/shown -->
            <div id="assignment-form" style="display:@(Model.SimCard == null ? "block" : "none")">
                <h3>@(Model.SimCard != null ? "Change" : "Assign") SimCard</h3>
                <form asp-action="AssignSimCard" method="post" id="assignSimCardForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="vehicleId" value="@Model.Id" />
                    <div class="simcard-form-group">
                        <label for="simCardId">Select SimCard:</label>
                        <select name="simCardId" id="simCardId" class="simcard-form-control" required>
                            <option value="">-- Select a SimCard --</option>
                            <!-- This will be populated via AJAX -->
                        </select>
                        <small class="simcard-help-text">Choose an available SimCard for this vehicle</small>
                    </div>
                    <div class="simcard-form-actions">
                        <button type="submit" class="simcard-btn simcard-btn-success" id="submitBtn">
                            <i class="fas fa-check" style="color:white !important;"></i> <span style="color:white !important;">@(Model.SimCard != null ? "Change" : "Assign") SimCard</span>
                        </button>
                        @if (Model.SimCard != null)
                        {
                        <button type="button" class="simcard-btn simcard-btn-secondary" onclick="hideAssignmentForm()">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Sidebar Section -->
    <div class="right-container">
        <h2>Actions</h2>
        <ul>
            <li><a asp-action="Details" asp-route-id="@Model.Id"><i class="fa-solid fa-info"></i> Information</a></li>
            <li><a asp-action="Maintenance" asp-route-id="@Model.Id"><i class="fa-solid fa-wrench"></i> Maintenance</a></li>
            <li><a asp-action="SimCard" asp-route-id="@Model.Id" class="current-view"><i class="fa-solid fa-sim-card"></i> SimCard</a></li>
            <li><a asp-action="Geofence" asp-route-id="@Model.Id"><i class="fa-solid fa-draw-polygon"></i> Geofence</a></li>
            <li><a asp-action="Tracking" asp-route-id="@Model.Id"><i class="fa-solid fa-location-dot"></i> Tracking</a></li>
            <li><a asp-action="Edit" asp-route-id="@Model.Id"><i class="fa-solid fa-edit"></i> Edit</a></li>
        </ul>
    </div>
</div>

<script>
function showAssignmentForm() {
    console.log('showAssignmentForm called');
    var form = document.getElementById('assignSimCardForm');
    if (form) {
        form.reset(); // Reset form fields
    }
    var assignmentForm = document.getElementById('assignment-form');
    if (assignmentForm) {
        assignmentForm.style.display = 'block';
        // Optionally scroll to the form for better UX
        assignmentForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    loadAvailableSimCards(); // Always reload available SimCards
}

function hideAssignmentForm() {
    console.log('hideAssignmentForm called');
    document.getElementById('assignment-form').style.display = 'none';
}

function loadAvailableSimCards() {
    console.log('loadAvailableSimCards called');
    const select = document.getElementById('simCardId');
    if (!select) {
        console.warn('SimCard select element not found!');
        return;
    }
    fetch('/SimCards/GetAvailableSimCards')
        .then(response => {
            console.log('SimCards API response status:', response.status);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            console.log('SimCards data received:', data);
            select.innerHTML = '<option value="">-- Select a SimCard --</option>';
            
            data.forEach(simCard => {
                const option = document.createElement('option');
                option.value = simCard.id;
                option.textContent = `${simCard.simNumber} (${simCard.carrier})`;
                select.appendChild(option);
            });
            
            // Remove any previous error message
            const helpText = select.parentNode.querySelector('.simcard-error-text');
            if (helpText) helpText.remove();
            
            // Initialize searchable dropdown after loading options
            if (window.SimCardSearchableDropdown) {
                // Remove existing searchable dropdown if any
                const existingWrapper = select.parentNode.querySelector('.searchable-dropdown-wrapper');
                if (existingWrapper) {
                    existingWrapper.remove();
                    select.style.display = '';
                }
                
                // Initialize new searchable dropdown
                new window.SimCardSearchableDropdown(select);
                console.log('Searchable dropdown initialized for SimCard select');
            }
        })
        .catch(error => {
            console.error('Error loading SimCards:', error);
            select.innerHTML = '<option value="">-- Select a SimCard --</option>';
            // Remove any previous error message
            const oldMsg = select.parentNode.querySelector('.simcard-error-text');
            if (oldMsg) oldMsg.remove();
            // Show friendly error message below the dropdown
            const msg = document.createElement('div');
            msg.className = 'simcard-error-text';
            msg.style.color = '#dc3545';
            msg.style.marginTop = '4px';
            msg.textContent = 'No SimCards found or failed to load.';
            select.parentNode.appendChild(msg);
            // Still initialize the searchable dropdown (empty)
            if (window.SimCardSearchableDropdown) {
                const existingWrapper = select.parentNode.querySelector('.searchable-dropdown-wrapper');
                if (existingWrapper) {
                    existingWrapper.remove();
                    select.style.display = '';
                }
                new window.SimCardSearchableDropdown(select);
            }
        });
}

function removeSimCard() {
    if (confirm('Are you sure you want to remove the SimCard from this vehicle? GPS tracking will stop working.')) {
        fetch('/Vehicles/RemoveSimCard/@Model.Id', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => {
            if (response.ok) {
                location.reload();
            } else {
                alert('Error removing SimCard');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error removing SimCard');
        });
    }
}

// Add form submission debugging
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('assignSimCardForm');
    if (form) {
        console.log('Form found, adding submit listener');
        form.addEventListener('submit', function(e) {
            console.log('Form submit event triggered');
            console.log('Form action:', form.action);
            console.log('Form method:', form.method);
            
            const vehicleId = form.querySelector('input[name="vehicleId"]').value;
            const simCardId = form.querySelector('select[name="simCardId"]').value;
            
            console.log('Vehicle ID:', vehicleId);
            console.log('SimCard ID:', simCardId);
            
            if (!simCardId) {
                console.log('No SimCard selected, preventing submission');
                e.preventDefault();
                alert('Please select a SimCard');
                return false;
            }
            
            console.log('Form submission proceeding...');
        });
    } else {
        console.log('Form not found');
    }
    
    // Auto-load SimCards if no SimCard is assigned (form is visible)
    const assignmentForm = document.getElementById('assignment-form');
    if (assignmentForm && assignmentForm.style.display !== 'none') {
        console.log('No SimCard assigned, auto-loading available SimCards');
        loadAvailableSimCards();
    }
});
</script>

<script src="~/js/simcard/searchable-dropdowns.js"></script> 