@model IEnumerable<SmartFleet.Models.SimCard>

@{
    ViewData["Title"] = "Sim Card List";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/simcard/list.css">

       <style>
        button {
            color: white !important;
        }
        button * {
            color: white !important;
        }
        #modalTitle {
            color: white !important;
        }
    </style>
</head>

<!-- Display success/error messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p class="add-simcard">
    <a asp-action="Create" class="btn btn-add-car"><i class="fas fa-sim-card sim-icon"></i> Add SimCard</a>
</p>

<div class="simcard-filter-bar">
    <form asp-action="Index" method="get" class="d-flex align-items-center flex-wrap gap-2 w-100">
        <div class="form-group mx-2">
            <input type="text" name="searchSimNumber" value="@Context.Request.Query["searchSimNumber"]" class="form-control form-control-sm" placeholder="Search Sim Number" />
        </div>
        <div class="form-group mx-2">
            <input type="text" name="searchCarrier" value="@Context.Request.Query["searchCarrier"]" class="form-control form-control-sm" placeholder="Search Carrier" />
        </div>
        <div class="form-group mx-2">
            <select name="statusFilter" class="form-control form-control-sm">
                <option value="">All Statuses</option>
                @foreach (SmartFleet.Models.SimCardStatus state in Enum.GetValues(typeof(SmartFleet.Models.SimCardStatus)))
                {
                    <option value="@state" selected="@(Context.Request.Query["statusFilter"] == state.ToString() ? "selected" : null)">@state</option>
                }
            </select>
        </div>
        <div class="simcard-filter-actions">
            <button type="submit" class="btn btn-sm custom-btn">
                <i class="fas fa-filter"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-sm btn-secondary ms-2">Clear</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table id="simcard-table" class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.SimNumber)</th>
                <th>@Html.DisplayNameFor(model => model.Carrier)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th>Assignment</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var assignedVehicle = ViewBag.VehicleAssignments != null && ViewBag.VehicleAssignments.ContainsKey(item.Id) 
                    ? ViewBag.VehicleAssignments[item.Id] : null;
                
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.SimNumber)</td>
                    <td>@Html.DisplayFor(modelItem => item.Carrier)</td>
                    <td>
                        <span class="badge-status badge-@item.Status.ToString().ToLower()">
                            @Html.DisplayFor(modelItem => item.Status)
                        </span>
                    </td>
                    <td>
                        @if (assignedVehicle != null)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-link"></i> Assigned to @assignedVehicle.LicensePlate
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                <i class="fas fa-unlink"></i> Not Assigned
                            </span>
                        }
                    </td>
                    <td>
                        @if (item.Status == SmartFleet.Models.SimCardStatus.Active)
                        {
                            if (assignedVehicle != null)
                            {
                                <a href="#" onclick="assignToVehicle(@item.Id, '@item.SimNumber', true)" class="simcard-index-btn-assign">
                                    <i class="fas fa-cog"></i> Manage
                                </a>
                            }
                            else
                            {
                                <a href="#" onclick="assignToVehicle(@item.Id, '@item.SimNumber', false)" class="simcard-index-btn-assign">
                                    <i class="fas fa-link"></i> Assign
                                </a>
                            }
                        }
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-edit">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-details">
                            <i class="fas fa-info-circle"></i> Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-delete">
                            <i class="fas fa-trash-alt deleted_icon"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<br />
<!-- Pagination Controls -->
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new {
                        pageNumber = i,
                        searchSimNumber = ViewBag.SearchSimNumber,
                        searchCarrier = ViewBag.SearchCarrier,
                        statusFilter = ViewBag.StatusFilter
                    })">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Vehicle Assignment Modal -->
<div id="assignmentModal" class="simcard-index-modal" style="display: none;">
    <div class="simcard-index-modal-content">
        <div class="simcard-index-modal-header">
            <h3 id="modalTitle">Assign SimCard to Vehicle</h3>
            <span class="simcard-index-modal-close" onclick="closeAssignmentModal()">&times;</span>
        </div>
        <div class="simcard-index-modal-body">
            <p id="modalDescription">Select a vehicle to assign SimCard <strong id="selectedSimNumber"></strong> to:</p>
            <form id="assignmentForm" asp-action="AssignToVehicle" method="post">
                <input type="hidden" id="simCardId" name="simCardId" />
                <div class="simcard-index-form-group">
                    <label for="vehicleSelect">Vehicle:</label>
                    <select id="vehicleSelect" name="vehicleId" class="simcard-index-form-control" required>
                        <option value="">-- Select a Vehicle --</option>
                    </select>
                </div>
                <div class="simcard-index-form-actions">
                    <button type="submit" class="simcard-index-btn simcard-index-btn-success">
                        <i class="fas fa-check"></i> <span id="submitButtonText">Assign SimCard</span>
                    </button>
                    <button type="button" class="simcard-index-btn simcard-index-btn-secondary" onclick="closeAssignmentModal()">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
// Global variables to track state
let currentSimCardId = null;
let currentSimNumber = null;
let isReassignMode = false;

function assignToVehicle(simCardId, simNumber, isReassign) {
    console.log('=== assignToVehicle START ===');
    console.log('Parameters:', { simCardId, simNumber, isReassign });
    
    // Store current state
    currentSimCardId = simCardId;
    currentSimNumber = simNumber;
    isReassignMode = isReassign;
    
    // Update modal content
    const selectedSimNumberElement = document.getElementById('selectedSimNumber');
    const simCardIdElement = document.getElementById('simCardId');
    const modalTitleElement = document.getElementById('modalTitle');
    const modalDescriptionElement = document.getElementById('modalDescription');
    const submitButtonTextElement = document.getElementById('submitButtonText');
    
    console.log('Updating modal elements...');
    
    if (selectedSimNumberElement) {
        selectedSimNumberElement.textContent = simNumber;
        console.log('Updated selectedSimNumber:', simNumber);
    } else {
        console.error('selectedSimNumber element not found!');
    }
    
    if (simCardIdElement) {
        simCardIdElement.value = simCardId;
        console.log('Updated simCardId:', simCardId);
    } else {
        console.error('simCardId element not found!');
    }
    
    if (isReassign) {
        if (modalTitleElement) modalTitleElement.textContent = 'Manage SimCard Assignment';
        if (modalDescriptionElement) modalDescriptionElement.innerHTML = 'Select a vehicle to reassign SimCard <strong>' + simNumber + '</strong> to, or choose "Remove Assignment" to unassign it:';
        if (submitButtonTextElement) submitButtonTextElement.textContent = 'Update Assignment';
        console.log('Set modal to reassign mode');
    } else {
        if (modalTitleElement) modalTitleElement.textContent = 'Assign SimCard to Vehicle';
        if (modalDescriptionElement) modalDescriptionElement.innerHTML = 'Select a vehicle to assign SimCard <strong>' + simNumber + '</strong> to:';
        if (submitButtonTextElement) submitButtonTextElement.textContent = 'Assign SimCard';
        console.log('Set modal to assign mode');
    }
    
    // Show modal
    const modal = document.getElementById('assignmentModal');
    if (modal) {
        modal.style.display = 'block';
        console.log('Modal displayed');
    } else {
        console.error('Modal element not found!');
    }
    
    // Load vehicles
    loadAvailableVehicles();
    
    console.log('=== assignToVehicle END ===');
}

function closeAssignmentModal() {
    console.log('=== closeAssignmentModal START ===');
    
    const modal = document.getElementById('assignmentModal');
    if (modal) {
        modal.style.display = 'none';
        console.log('Modal hidden');
    }
    
    // Reset form
    const form = document.getElementById('assignmentForm');
    if (form) {
        form.reset();
        console.log('Form reset');
    }
    
    const vehicleSelect = document.getElementById('vehicleSelect');
    if (vehicleSelect) {
        vehicleSelect.innerHTML = '<option value="">-- Select a Vehicle --</option>';
        console.log('Vehicle select cleared');
    }
    
    // Clear state
    currentSimCardId = null;
    currentSimNumber = null;
    isReassignMode = false;
    
    console.log('=== closeAssignmentModal END ===');
}

function loadAvailableVehicles() {
    console.log('=== loadAvailableVehicles START ===');
    console.log('isReassignMode:', isReassignMode);
    
    const select = document.getElementById('vehicleSelect');
    if (!select) {
        console.error('Vehicle select element not found!');
        return;
    }
    
    // Clear current options
    select.innerHTML = '<option value="">-- Select a Vehicle --</option>';
    console.log('Cleared vehicle select');
    
    fetch('/SimCards/GetAvailableVehicles')
        .then(response => {
            console.log('Fetch response status:', response.status);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            console.log('Vehicles data received:', data);
            console.log('Number of vehicles:', data.length);
            
            // Add remove option for reassignment
            if (isReassignMode) {
                const removeOption = document.createElement('option');
                removeOption.value = 'remove';
                removeOption.textContent = '-- Remove Assignment --';
                removeOption.style.color = '#dc3545';
                removeOption.style.fontWeight = 'bold';
                select.appendChild(removeOption);
                console.log('Added remove assignment option');
            }
            
            // Add vehicle options
            data.forEach((vehicle, index) => {
                const option = document.createElement('option');
                option.value = vehicle.id;
                const assignmentStatus = vehicle.isAssigned ? ' (Currently Assigned)' : ' (Available)';
                option.textContent = `${vehicle.licensePlate} - ${vehicle.model} (${vehicle.type})${assignmentStatus}`;
                select.appendChild(option);
                console.log(`Added vehicle option ${index + 1}:`, vehicle.licensePlate);
            });
            
            console.log('Total options in select:', select.options.length);
        })
        .catch(error => {
            console.error('Error loading vehicles:', error);
            alert('Error loading available vehicles. Please try again.');
        });
    
    console.log('=== loadAvailableVehicles END ===');
}

// Handle form submission
function handleAssignmentSubmit(event) {
    event.preventDefault();
    console.log('=== handleAssignmentSubmit START ===');
    
    const vehicleSelect = document.getElementById('vehicleSelect');
    const selectedValue = vehicleSelect.value;
    const simCardId = document.getElementById('simCardId').value;
    
    console.log('Form submission details:', {
        selectedValue,
        simCardId,
        currentSimCardId
    });
    
    if (selectedValue === 'remove') {
        if (confirm('Are you sure you want to remove this SimCard assignment?')) {
            console.log('Removing assignment...');
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/SimCards/RemoveAssignment';
            
            const simCardInput = document.createElement('input');
            simCardInput.type = 'hidden';
            simCardInput.name = 'simCardId';
            simCardInput.value = simCardId;
            
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            form.appendChild(simCardInput);
            form.appendChild(tokenInput);
            document.body.appendChild(form);
            form.submit();
        }
    } else if (selectedValue === '') {
        alert('Please select a vehicle or remove assignment option.');
    } else {
        console.log('Submitting assignment form...');
        event.target.submit();
    }
    
    console.log('=== handleAssignmentSubmit END ===');
}

// Close modal when clicking outside
window.onclick = function(event) {
    const modal = document.getElementById('assignmentModal');
    if (event.target === modal) {
        closeAssignmentModal();
    }
}

// Initialize when page loads
document.addEventListener('DOMContentLoaded', function() {
    console.log('=== DOMContentLoaded START ===');
    
    // Add form submission handler
    const form = document.getElementById('assignmentForm');
    if (form) {
        form.addEventListener('submit', handleAssignmentSubmit);
        console.log('Form submission handler added');
    } else {
        console.error('Assignment form not found!');
    }
    
    console.log('=== DOMContentLoaded END ===');
});
</script>
